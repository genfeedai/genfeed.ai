#!/usr/bin/env sh

# Run lint-staged (Biome check + format on staged files only)
export PATH="$HOME/.bun/bin:$PATH"

if ! command -v bun >/dev/null 2>&1; then
  echo "Bun is required for pre-commit hooks. Install Bun or add it to PATH." >&2
  exit 127
fi

bun x lint-staged

# Real env files (.env, .env.local, .env.production, ...) never get committed;
# only .env.example templates do.
bun scripts/env-check.ts --staged
