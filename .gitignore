node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock
__pycache__/
dist/
# covers apps/server/dist and every other package emit. Do not track build output.
packages/prisma/generated/
packages/desktop-prisma/generated/
.next/
.turbo/
*.tsbuildinfo
# Compiled output never belongs in src/ or app/ — catch misconfigured tsc/swc emitting inline
**/src/**/*.js
**/src/**/*.js.map
**/src/**/*.d.ts.map
**/src/**/*.d.ts
# Next.js App Router source dirs — no compiled .js alongside .tsx
apps/app/app/**/*.js
apps/app/app/**/*.js.map
apps/app/packages/**/*.js
apps/app/packages/**/*.js.map
# Hand-authored ambient module declarations / generated API types — keep tracked
!apps/app/src/types/*.d.ts
!apps/desktop/app/src/shared/*.d.ts
!apps/server/api/src/helpers/test/*.d.ts
!apps/server/api/src/types/*.d.ts
!packages/api-types/src/generated/*.d.ts
!packages/ui/src/css.d.ts
!packages/workflow-ui/src/css.d.ts
.env
.env.local
.env.*.local
.DS_Store
coverage/
coverage-all/
coverage-cron/
apps/*/.vitest-reports/
.vercel
out/
*.log
next-env.d.ts
apps/desktop/app/build/
apps/desktop/app/release/
apps/server/files/remotion-bundle/
*.dmg
*.zip
.env.production
.env.staging
.env.local
# Local env/DB backups & dumps — contain live secrets, never commit
*.rdsbak
*.sqlbak
*.dump
.env.*.bak
.claude/worktrees/
.codex/worktrees/
.claude/skills/
.worktrees/
# Session logs are local-only. Both spellings are listed on purpose: the canonical
# directory is lowercase, but a case-sensitive filesystem would not ignore a stray
# uppercase one, and `git add -A` would then commit it to this public repo.
.agents/sessions/
.agents/SESSIONS/
.agents/plans/
.agents/memory/local/
.clawpatch/
.genfeed/
.package-release/

# ShipCode interactive prompt/output scratch
.shipcode/runs/

# Playwright generated artifacts: reports, traces, videos, screenshots, and legacy auth provider storageState
playwright/artifacts/
playwright/.authProvider/
playwright-report/
playwright-results/
test-results/

# Claude Code skill runtime (should never be committed)
.superpowers/
# Agent scratch dirs at any depth (apps/<name>/.agents/, apps/<surface>/<name>/.agents/)
# Covers apps/app/.agents, apps/mobile/app/.agents, apps/extensions/browser/app/.agents, etc.
**/apps/**/.agents/
# Stray nested clone/worktree scratch dir — never a real git worktree, never committed.
# Without this, `git add -A` grabs its placeholder files into unrelated commits.
.clone/
coverage-shard/

# Machine-local SEO watchdog crawler, snapshots, and run artifacts
reports/seo/

# OpenTofu working directories
**/.terraform/

# Generated OpenAPI artifact — emitted by `bun run --filter=@genfeedai/api openapi:emit`;
# CI validates a fresh emission per PR (openapi-drift job) and the live API serves /v1/openapi.json dynamically.
apps/server/api/openapi/openapi.json

# Machine-local scratch for QA/session runs — holds session tokens and
# throwaway query output. Never committed; this repo is public.
.tmp/
