# Genfeed.ai Community environment
#
# Community is single-tenant. Sign-up is open out of the box: the first visitor
# creates an account at http://localhost:3000 and completes onboarding. Copy this
# file to .env next to compose.yml (in a source checkout: docker/.env), set
# OPENROUTER_API_KEY, then start the stack. The container will not start without
# a real OpenRouter key. Add keys for any other providers you use.
#
# Every variable below is tagged on the line above it:
#   REQUIRED  the container cannot start until you set it.
#   OPTIONAL  safe to leave empty. It has a built-in default or an automatic
#             fallback, or it only unlocks an add-on integration.
# OPENROUTER_API_KEY is the only REQUIRED variable in this bundle.

# OPTIONAL: Container image tag; compose falls back to latest. Release bundles pin it to the exact release version, so only edit it to upgrade.
GENFEED_IMAGE_TAG=latest

# OPTIONAL: Domain you own (for example studio.example.com); blank uses localhost. Configure TLS and proxy /v1 to the API and /mcp to MCP for a domain install.
SELFHOSTED_DOMAIN=

# Published host ports: 3000 (web), 3010 (API), 3011 (WebSocket), 3014 (MCP).
# Compose defaults apply when a port is unset; container-side ports are fixed.
# WebSocket binds to 127.0.0.1:3011. SELFHOSTED_WS_PORT changes only its host
# port; a different port needs a proxy at the browser's built-in localhost:3011
# endpoint or a custom image with a matching NEXT_PUBLIC_WS_ENDPOINT.
# OPTIONAL: Host port for the web UI; defaults to 3000.
SELFHOSTED_APP_PORT=3000
# OPTIONAL: Host port for the API, bound to 127.0.0.1 only; defaults to 3010.
SELFHOSTED_API_PORT=3010
# OPTIONAL: Host port for the MCP server; defaults to 3014.
SELFHOSTED_MCP_PORT=3014

# Model provider keys. Keep keys server-side.
#
# OPENROUTER_API_KEY is REQUIRED for text generation and the agent: Genfeed's
# default text and agent models are served through OpenRouter. Without a real,
# non-placeholder key the container exits before starting services. Create one
# at https://openrouter.ai/keys (it starts with sk-or-). Startup checks the key's
# format; successful provider access still depends on your account and key.
#
# Use real keys only. Do not leave placeholder text such as "your_key_here":
# Settings -> API Keys validates every key against the provider before saving
# it, so a placeholder is rejected there, and a placeholder in this file stops
# startup. After editing .env, recreate the stack using its Compose file:
#   Release bundle: docker compose --env-file .env -f compose.yml up -d
#   Source checkout, from docker/: docker compose --env-file .env -f docker-compose.selfhosted.yml up -d
# REQUIRED: OpenRouter key; missing or placeholder values stop container startup.
OPENROUTER_API_KEY=
# OPTIONAL: Enables native OpenAI models (openai/* ids). Other models still need OpenRouter.
OPENAI_API_KEY=
# OPTIONAL: Enables native Anthropic (Claude) models; without it, use Claude through OpenRouter.
ANTHROPIC_API_KEY=
# OPTIONAL: Enables Replicate-hosted generation models; they are unavailable without it.
REPLICATE_KEY=
# OPTIONAL: Enables fal image and video models; they are unavailable without it.
FAL_API_KEY=
# OPTIONAL: Enables ElevenLabs voice generation; it is unavailable without it.
ELEVENLABS_API_KEY=

# Use a Logo.dev publishable `pk_` key only; secret `sk_` keys are never
# accepted or exposed by this integration.
# OPTIONAL: Enables the Logo.dev company-logo fallback used when scraping brands.
LOGO_DEV_PUBLISHABLE_KEY=

# The Community image does not start ComfyUI or the separate GPU service
# workspaces.
# OPTIONAL: URL of your own ComfyUI server for supported API flows; those flows stay off when empty.
DARKROOM_COMFYUI_URL=

# Login and sign-up. Enabled by default so the first visitor can create an
# account at http://localhost:3000. Set both flags to false only for an
# unauthenticated, single-user local workspace.
# OPTIONAL: Turns login and sign-up on (true, the default) or off (false: no login wall, seeded single-user workspace).
BETTER_AUTH_ENABLED=true
# OPTIONAL: Browser-side mirror of BETTER_AUTH_ENABLED; keep it equal. Defaults to the same value.
NEXT_PUBLIC_BETTER_AUTH_ENABLED=true
# OPTIONAL: Session signing secret. May stay empty: the entrypoint generates one and persists it at /data/.better-auth-secret. Set it only to supply your own (stable across rebuilds).
BETTER_AUTH_SECRET=
# OPTIONAL: Public URL of the API's auth endpoints; defaults to the API public URL (http://localhost:3010). Change it when users reach the API through another host.
BETTER_AUTH_URL=
# OPTIONAL: Comma-separated browser origins allowed to sign in; defaults to the app URL (http://localhost:3000). Add your domain when you serve the app from another host.
BETTER_AUTH_TRUSTED_ORIGINS=

# The login page offers Email / Password by default (no mail provider needed).
# Magic Link appears only when RESEND_API_KEY is set; Google sign-in works only
# when GOOGLE_OAUTH_CLIENT_ID and GOOGLE_OAUTH_CLIENT_SECRET are both set.
# The login wall protects the web UI and authenticated REST API routes.
# OPTIONAL: Resend key for transactional email; magic links, password resets, verification and invites do not send without it.
RESEND_API_KEY=
# OPTIONAL: Google OAuth client ID; enables Google sign-in together with the secret below.
GOOGLE_OAUTH_CLIENT_ID=
# OPTIONAL: Google OAuth client secret; Google sign-in stays off without it.
GOOGLE_OAUTH_CLIENT_SECRET=

# Restream OAuth (livestream chat ingest). Connect fails closed when unset.
# OPTIONAL: Restream OAuth client ID; Restream connect is disabled without it.
RESTREAM_CLIENT_ID=
# OPTIONAL: Restream OAuth client secret; Restream connect is disabled without it.
RESTREAM_CLIENT_SECRET=
# OPTIONAL: Restream OAuth callback URL; Restream connect is disabled without it.
RESTREAM_REDIRECT_URI=
