# Genfeed.ai Community environment
#
# Community is single-tenant and starts without a login wall. Copy this file to
# docker/.env and add only the optional integrations you use.

# Container image. Release bundles replace latest with the exact release version.
GENFEED_IMAGE_TAG=latest

# Host ports exposed by docker-compose.selfhosted.yml.
SELFHOSTED_APP_PORT=3000
SELFHOSTED_API_PORT=3010
SELFHOSTED_MCP_PORT=3014

# REQUIRED for text generation: OpenRouter key.
# Chat, agents, post drafts, prompt enhancement, newsletters, and workflow LLM
# steps all route through OpenRouter. Without it the first generation fails with
# "Missing provider key: OPENROUTER_API_KEY".
# An OpenAI or Anthropic key below does NOT replace it: those keys only serve
# openai/* and anthropic/* model ids, and branded drafts are OpenRouter-only.
# Get a key at https://openrouter.ai/keys, uncomment the line, paste it, then
# recreate the stack: docker compose -f docker-compose.selfhosted.yml up -d
# (a plain restart does not re-read this file).
# You can instead save an OpenRouter key per organization in the app under
# Organization settings > Integrations.
# OPENROUTER_API_KEY=

# Optional generation providers. Keep keys server-side.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=

# Optional company-logo fallback. Use a Logo.dev publishable `pk_` key only;
# secret `sk_` keys are never accepted or exposed by this integration.
LOGO_DEV_PUBLISHABLE_KEY=

# Optional local ComfyUI endpoint used by supported API flows. The Community
# image does not start ComfyUI or the separate GPU service workspaces.
DARKROOM_COMFYUI_URL=

# Optional login wall. The entrypoint generates and persists a Better Auth
# secret under /data/.better-auth-secret when BETTER_AUTH_SECRET is empty.
BETTER_AUTH_ENABLED=false
NEXT_PUBLIC_BETTER_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional auth providers and transactional email. Magic links, password resets,
# verification, and invites need RESEND_API_KEY. The login page itself only
# offers Google and Magic Link; see the self-host docs for creating the first
# user when signup is off.
RESEND_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional Restream OAuth (livestream chat ingest). Connect fails closed when unset.
RESTREAM_CLIENT_ID=
RESTREAM_CLIENT_SECRET=
RESTREAM_REDIRECT_URI=
