# Genfeed.ai Community environment
#
# Community is single-tenant. Sign-up is open out of the box: the first visitor
# creates an account at http://localhost:3000 and completes onboarding. Copy this
# file to docker/.env and add the keys for the providers you use.

# Container image. Release bundles replace latest with the exact release version.
GENFEED_IMAGE_TAG=latest

# Host ports exposed by docker-compose.selfhosted.yml.
SELFHOSTED_APP_PORT=3000
SELFHOSTED_API_PORT=3010
SELFHOSTED_MCP_PORT=3014

# Model provider keys. Keep keys server-side.
#
# OPENROUTER_API_KEY is REQUIRED for text generation and the agent: Genfeed's
# default text and agent models are served through OpenRouter. Without a valid
# key the install-readiness check reports text generation as not ready and the
# first agent turn fails. Create a key at https://openrouter.ai/keys (it starts
# with sk-or-).
#
# Use real keys only. Do not leave placeholder text such as "your_key_here":
# Settings -> API Keys validates every key against the provider before saving
# it, so a placeholder is rejected there, and a placeholder in this file is
# reported as "not configured". After editing this file, restart the stack:
#   docker compose --env-file .env -f compose.yml up -d
OPENROUTER_API_KEY=
# Optional: native OpenAI models (openai/* ids). Other models still need OpenRouter.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=

# Optional company-logo fallback. Use a Logo.dev publishable `pk_` key only;
# secret `sk_` keys are never accepted or exposed by this integration.
LOGO_DEV_PUBLISHABLE_KEY=

# Optional local ComfyUI endpoint used by supported API flows. The Community
# image does not start ComfyUI or the separate GPU service workspaces.
DARKROOM_COMFYUI_URL=

# Login and sign-up. Enabled by default so the first visitor can create an
# account at http://localhost:3000. Set both flags to false only for an
# unauthenticated, single-user local workspace. The entrypoint generates and
# persists a Better Auth secret under /data/.better-auth-secret when
# BETTER_AUTH_SECRET is empty.
BETTER_AUTH_ENABLED=true
NEXT_PUBLIC_BETTER_AUTH_ENABLED=true
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Optional auth providers and transactional email. Magic links, password resets,
# verification, and invites need RESEND_API_KEY. The login page itself only
# offers Google and Magic Link; see the self-host docs for creating the first
# user when signup is off.
RESEND_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional Restream OAuth (livestream chat ingest). Connect fails closed when unset.
RESTREAM_CLIENT_ID=
RESTREAM_CLIENT_SECRET=
RESTREAM_REDIRECT_URI=
