# ==================================================
# Unified Server Dockerfile
# Builds the public NestJS services in a single image
# Services: api, files, workers, mcp, notifications,
#           telegram, discord, slack
# ==================================================

# ==================================================
# Stage 1: Toolchain
# ==================================================
FROM node:24-slim AS toolchain

# Docker cannot read `.bun-version` before selecting/installing its toolchain.
# The unpinned installer intentionally mirrors that rolling policy, and the CI
# policy contract keeps both installer stages aligned with it.
# Install bun and build dependencies. node-pty in @genfeedai/notifications
# compiles during bun install and expects node-gyp on PATH.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    unzip \
    ffmpeg \
    python3 \
    make \
    g++ \
    && curl -fsSL https://bun.sh/install | bash \
    && cp /root/.bun/bin/bun /usr/local/bin/bun \
    && cp /root/.bun/bin/bunx /usr/local/bin/bunx \
    && chmod +x /usr/local/bin/bun /usr/local/bin/bunx \
    && npm install -g node-gyp \
    && apt-get purge -y unzip \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/usr/local/bin:${PATH}"

# Point ffmpeg-static at the apt ffmpeg installed above. Its index.js exports
# $FFMPEG_BIN verbatim and install.js skips the ~40MB GitHub-CDN download during
# `bun install` below when the path exists — removing that per-build CDN call
# entirely. The runtime code always imports the ffmpeg-static export, so this
# must also be set in the production stage (see below), which is a fresh base.
ENV FFMPEG_BIN=/usr/bin/ffmpeg

# Mandatory for production build — give each parallel build enough memory
ENV NODE_OPTIONS=--max-old-space-size=4096

# ==================================================
# Stage 2: Pruner - Produce a lockfile-backed server workspace
# ==================================================
FROM toolchain AS pruner

# Keep this exact version aligned with the root turbo devDependency. The
# resulting /pruned/json tree contains both the reduced workspace manifests and
# the matching pruned bun.lock, so subsequent installs can be frozen.
RUN bun add --global turbo@2.10.7

WORKDIR /ctx

RUN --mount=type=bind,source=.,target=/ctx,ro \
    /root/.bun/bin/turbo prune \
      @genfeedai/api \
      @genfeedai/discord \
      @genfeedai/files \
      @genfeedai/mcp \
      @genfeedai/notifications \
      @genfeedai/server \
      @genfeedai/slack \
      @genfeedai/telegram \
      @genfeedai/workers \
      --docker \
      --out-dir /pruned

# The runtime dependency layer needs a different graph: excluding workspace
# devDependencies here keeps compiler/build packages out of both its manifests
# and its pruned lockfile, instead of asking Bun to filter a build-complete graph.
RUN --mount=type=bind,source=.,target=/ctx,ro \
    /root/.bun/bin/turbo prune \
      @genfeedai/api \
      @genfeedai/discord \
      @genfeedai/files \
      @genfeedai/mcp \
      @genfeedai/notifications \
      @genfeedai/server \
      @genfeedai/slack \
      @genfeedai/telegram \
      @genfeedai/workers \
      --production \
      --docker \
      --out-dir /pruned-production

# ==================================================
# Stage 3: Base - Install the frozen build dependency graph
# ==================================================
FROM toolchain AS base

WORKDIR /usr/src/app

# Turbo's Docker prune output is manifest-only and includes the compatible
# pruned lockfile. Drop the repository-only root postinstall before dependency
# installation; workspace lifecycle scripts (Prisma, node-pty, etc.) still run.
COPY --from=pruner /pruned/json/ ./
RUN node -e "\
  const fs=require('fs');\
  const p=JSON.parse(fs.readFileSync('package.json','utf8'));\
  if(p.scripts) delete p.scripts.postinstall;\
  fs.writeFileSync('package.json', JSON.stringify(p,null,2)+'\n');"

# @genfeedai/prisma runs `prisma generate` during install, so its schema must
# exist in the manifest-only dependency layer.
COPY packages/prisma/prisma.config.mjs ./packages/prisma/prisma.config.mjs
COPY packages/prisma/prisma/ ./packages/prisma/prisma/

# Keep patch files available when a dependency in the pruned graph is patched.
COPY patches/ patches/

# Nest's webpack externalizer expects conventional node_modules paths; an
# isolated graph makes it bundle Remotion/Rspack native binaries from .bun
# paths. The targeted dependency patches above keep the hoisted graph safe.
RUN --mount=type=cache,id=bun-cache,target=/root/.bun/install/cache \
    HUSKY=0 bun install --frozen-lockfile --linker hoisted

# ==================================================
# Stage 4: Production dependencies
# ==================================================
FROM toolchain AS production-deps

WORKDIR /usr/src/app

COPY --from=pruner /pruned-production/json/ ./
RUN node -e "\
  const fs=require('fs');\
  const p=JSON.parse(fs.readFileSync('package.json','utf8'));\
  if(p.scripts) delete p.scripts.postinstall;\
  fs.writeFileSync('package.json', JSON.stringify(p,null,2)+'\n');"
COPY packages/prisma/prisma.config.mjs ./packages/prisma/prisma.config.mjs
COPY packages/prisma/prisma/ ./packages/prisma/prisma/
COPY patches/ patches/

# Install a conventional root-resolvable runtime graph from the
# production-pruned frozen lockfile. Nest's bundles externalize third-party
# dependencies against this layout; Bun keeps conflicting versions nested while
# the production prune keeps build dependencies out. Prisma remains a runtime
# dependency because migration jobs execute it after the image is built.
RUN --mount=type=cache,id=bun-production-cache,target=/root/.bun/install/cache \
    HUSKY=0 bun install --production --frozen-lockfile --linker hoisted
RUN cd apps/server/files && \
    bun -e "import { ensureBrowser } from '@remotion/renderer'; await ensureBrowser();"

# Prisma declares TypeScript as an optional peer, so Bun installs the repository's
# TS6 API package even during a frozen production install. This image uses the
# JavaScript prisma.config.mjs and never compiles at runtime; remove that
# optional tool plus its command shims after lifecycle scripts have completed.
RUN find node_modules -type d \
      \( -path 'node_modules/typescript' -o -path '*/node_modules/typescript' \) \
      -prune -exec rm -rf '{}' + && \
    find node_modules -type l \
      \( -name tsc -o -name tsserver \) -delete
RUN set -e; \
    leaked_typescript="$(find node_modules -type f -path '*/typescript/package.json' -print -quit)"; \
    if [ -n "$leaked_typescript" ]; then \
      echo "Unexpected runtime TypeScript package: $leaked_typescript"; \
      exit 1; \
    fi; \
    for dependency in typescript @typescript/native tsup tsc-alias; do \
      if [ -e "node_modules/$dependency" ]; then \
        echo "Unexpected runtime build dependency: $dependency"; \
        exit 1; \
      fi; \
    done

# ==================================================
# Stage 5: Builder - Build all services
# ==================================================
FROM base AS builder

# --- Layer 1: Root configs + shared packages (cached when only services change) ---
COPY tsconfig.json tsconfig.server.decorators.json webpack.base.config.js ./
COPY configs/ configs/
COPY packages/ packages/

# Copy server-level configs needed before service source
COPY apps/server/nest-cli.json apps/server/nest-cli.json
COPY apps/server/tsconfig.json apps/server/tsconfig.json

# Build shared workspace packages in dependency order (must run before service builds)
# This layer is cached when only apps/server/* source changes
# Some workspace packages export dist paths, so build those before packages that
# compile against their package exports.
RUN set -e; \
    bun --filter @genfeedai/enums build; \
    bun --filter @genfeedai/constants build; \
    bun --filter @genfeedai/interfaces build; \
    bun --filter @genfeedai/api-types build; \
    bun --filter @genfeedai/pricing build; \
    bun --filter @genfeedai/client build; \
    pids=""; \
    bun --filter @genfeedai/types build & pids="$pids $!"; \
    bun --filter @genfeedai/config build & pids="$pids $!"; \
    ec=0; for p in $pids; do wait "$p" || ec=1; done; [ "$ec" = 0 ]; \
    bun --filter @genfeedai/helpers build; \
    bun --filter @genfeedai/integrations build; \
    bun --filter @genfeedai/serializers build; \
    bun --filter @genfeedai/workflows build:server

# --- Layer 2: Service source code (changes most frequently) ---
COPY apps/server/ apps/server/

# Bundle the pinned composition during the image build so the first customer
# render does not pay a webpack startup penalty.
RUN cd apps/server/files && \
    bun -e "import { bundle } from '@remotion/bundler'; import { resolve } from 'node:path'; await bundle({entryPoint:resolve('src/remotion/index.tsx'),outDir:resolve('remotion-bundle'),publicDir:null,rootDir:resolve('.')});"

# Patch nest-cli.json AFTER copying source (the COPY above would overwrite any earlier patch)
# Disable deleteOutDir so parallel builds don't wipe each other's outputs from apps/server/dist/
RUN sed -i 's/"deleteOutDir": true/"deleteOutDir": false/' apps/server/nest-cli.json

# Build all services in parallel batches
# Batch 0: API alone (largest service, needs full resources)
RUN --mount=type=secret,id=SENTRY_AUTH_TOKEN \
    SENTRY_AUTH_TOKEN=$(cat /run/secrets/SENTRY_AUTH_TOKEN 2>/dev/null || echo "") \
    bun --filter @genfeedai/api build:prod

# Workers alone: large dependency footprint (imports @api/shared), needs dedicated resources
RUN bun --filter @genfeedai/workers build:prod

# Batch 1: Other Sentry services (3 builds in parallel).
# The previous `(...) & pidN=$! && ... wait $pid1 $pid2 $pid3` had TWO bugs: the
# `& pidN=$! &&` chaining captured pids inside backgrounded subshells (not the
# main shell), so the RUN only ever waited on the last job — a still-writing mcp
# could be truncated to a 0-byte main.js when notifications finished first (the
# #1292-era bundle bug); and `wait a b c` returns only c's status, swallowing a
# non-last failure. The robust form below captures every pid in the MAIN shell
# (`;`, not `&&`), waits for ALL of them, and fails the layer if ANY failed.
# Applied to every parallel batch. Verified: succeeds clean, fails on any build.
RUN --mount=type=secret,id=SENTRY_AUTH_TOKEN \
    set -e; \
    pids=""; \
    (SENTRY_AUTH_TOKEN=$(cat /run/secrets/SENTRY_AUTH_TOKEN 2>/dev/null || echo "") bun --filter @genfeedai/files build:prod) & pids="$pids $!"; \
    (SENTRY_AUTH_TOKEN=$(cat /run/secrets/SENTRY_AUTH_TOKEN 2>/dev/null || echo "") bun --filter @genfeedai/mcp build:prod) & pids="$pids $!"; \
    (SENTRY_AUTH_TOKEN=$(cat /run/secrets/SENTRY_AUTH_TOKEN 2>/dev/null || echo "") bun --filter @genfeedai/notifications build:prod) & pids="$pids $!"; \
    ec=0; for p in $pids; do wait "$p" || ec=1; done; [ "$ec" = 0 ]

# Batch 2: Non-Sentry services (3 builds)
RUN set -e; \
    pids=""; \
    bun --filter @genfeedai/telegram build:prod & pids="$pids $!"; \
    bun --filter @genfeedai/discord build & pids="$pids $!"; \
    bun --filter @genfeedai/slack build:prod & pids="$pids $!"; \
    ec=0; for p in $pids; do wait "$p" || ec=1; done; [ "$ec" = 0 ]

# ==================================================
# Stage 2.5: Validate build outputs exist
# ==================================================
# Webpack bundles each service into a single main.js file.
# Verify the critical bundles exist AND are non-trivially sized before proceeding.
# The size floor (10KB) catches a truncated/empty emit (e.g. an OOM-killed
# webpack that leaves a 0-byte main.js) INSIDE the image build, so the poisoned
# layer fails fast and never enters the GHCR buildcache — mirroring the external
# size gate in build-verify.yml. `test -f` alone passes a 0-byte file.
RUN echo "Checking build outputs..." && \
    ls -la apps/server/dist/apps/ 2>/dev/null || echo "dist/apps/ directory missing!" && \
    for svc in api workers files mcp notifications telegram discord slack api-workflow-backfill api-articles-seed; do \
      if ! test -f "apps/server/dist/apps/$svc/main.js"; then \
        echo "❌ $svc bundle MISSING" && exit 1; \
      fi; \
      SIZE=$(stat -c%s "apps/server/dist/apps/$svc/main.js"); \
      if [ "$SIZE" -lt 10000 ]; then \
        echo "❌ $svc bundle suspiciously small (${SIZE} bytes)" && exit 1; \
      fi; \
      echo "✅ $svc bundle ($(( SIZE / 1024 ))KB)"; \
    done

# Execute the compiled seed entrypoint without touching a database. This proves
# the production bundle contains its launch data and actually reaches its CLI
# entrypoint rather than merely leaving a non-empty file on disk.
RUN node -r tsconfig-paths/register \
      apps/server/dist/apps/api-articles-seed/main \
      --validate-runtime

# ==================================================
# Stage 6: Production - Runtime image
# ==================================================
FROM node:24-slim AS production

# Install system dependencies for Bun, FFmpeg, and the pinned Remotion
# Chrome Headless Shell downloaded in the dependency layer.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    bash \
    unzip \
    ffmpeg \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libgbm1 \
    libasound2 \
    libxrandr2 \
    libxkbcommon0 \
    libxfixes3 \
    libxcomposite1 \
    libxdamage1 \
    libatk-bridge2.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    libcups2 \
    fontconfig \
    fonts-liberation \
    fonts-noto-cjk \
    fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# This stage is a fresh `FROM node:24-slim` — it does NOT inherit the base
# stage's ENV. The ffmpeg-static export honors $FFMPEG_BIN at module-eval time,
# and the download was skipped in the builder, so the bundled binary is absent
# from the copied node_modules; without this the files/api services would crash
# on boot with "FFmpeg binary not found". Points at the apt ffmpeg installed above.
ENV FFMPEG_BIN=/usr/bin/ffmpeg

# Install bun for running production scripts
RUN curl -fsSL https://bun.sh/install | bash && \
    cp /root/.bun/bin/bun /usr/local/bin/bun && \
    chmod +x /usr/local/bin/bun
ENV PATH="/usr/local/bin:${PATH}"

WORKDIR /usr/src/app

# Copy the frozen production workspace tree. This keeps
# production workspace resolution in lockstep with the install graph without
# copying shared-package source into the runtime image.
COPY --from=production-deps /usr/src/app/package.json ./package.json
COPY --from=production-deps /usr/src/app/apps/server/ ./apps/server/
COPY --from=production-deps /usr/src/app/packages/ ./packages/

# Copy built artifacts from the builder and runtime-only dependencies from the
# production dependency stage.
COPY --from=builder /usr/src/app/apps/server/dist ./apps/server/dist
COPY --from=builder /usr/src/app/apps/server/files/src/remotion ./apps/server/files/src/remotion
COPY --from=builder /usr/src/app/apps/server/files/remotion-bundle ./apps/server/files/remotion-bundle
COPY --from=production-deps /usr/src/app/node_modules ./node_modules

# First-party product skills (`skills/*/SKILL.md`) are the in-app catalog seed.
COPY skills/ ./skills/

# Every production server entrypoint preloads this module. Keep the assertion in
# the pruned runtime stage so a missing direct dependency fails image CI before
# one-off migrations or ECS services attempt to boot.
RUN node -e "require.resolve('tsconfig-paths/register')"

RUN test -x "$(find /usr/src/app -type f -name chrome-headless-shell -print -quit)"

# Create non-root user for security (with a real, writable home — spawned
# tools like yt-dlp/whisper write caches to $HOME and EACCES otherwise)
RUN groupadd -r appuser && useradd -r -g appuser -u 1001 -m -d /home/appuser appuser

# Set ownership for appuser (skip chown -R on node_modules — 100k+ files, very slow)
# Service dirs only contain package.json — chown is instant and lets app create logs/ at runtime
# `bun --filter` runs services with cwd = the package dir, so runtime dirs the
# services create relative to cwd (public/tmp, logs) must pre-exist there with
# appuser ownership. logs/ especially: compose mounts a named volume at
# apps/server/files/logs, and Docker only seeds the volume with appuser
# ownership if the directory exists in the image — otherwise the mountpoint is
# created root-owned and every mkdir/write under it fails with EACCES.
RUN mkdir -p /usr/src/app/public/tmp \
        /usr/src/app/apps/server/files/public/tmp \
        /usr/src/app/apps/server/files/logs && \
    chown appuser:appuser /usr/src/app && \
    chown -R appuser:appuser \
        /usr/src/app/apps/server \
        /usr/src/app/public

# RDS CA bundle — PrismaService passes this CA to PrismaPg for RDS DATABASE_URLs;
# without the file every Prisma query fails with
# "self-signed certificate in certificate chain".
RUN mkdir -p /certs && \
    curl -fsSL https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o /certs/rds-ca.pem && \
    chmod 444 /certs/rds-ca.pem

# Switch to non-root user
USER appuser
ENV HOME=/home/appuser

# No EXPOSE or HEALTHCHECK — each compose service defines its own
# Default CMD prints usage — each compose service overrides with command:
CMD ["echo", "ERROR: No service specified. Use command: [\"bun\", \"--filter\", \"@genfeedai/<service>\", \"start:prod\"]"]
