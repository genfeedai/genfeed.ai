{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "globalDependencies": [
    "bun.lock",
    ".env.example",
    ".env.local",
    ".env.staging",
    ".env.production",
    "scripts/env-check.ts",
    "scripts/env-spec.ts",
    "**/.env.*local"
  ],
  "globalEnv": ["GITHUB_EVENT_PATH"],
  "globalPassThroughEnv": ["GITHUB_REF_NAME", "TURBO_HASH"],
  "tasks": {
    // Package builds are declaration prerequisites for lint/typecheck and must
    // remain independent of machine-local application env. Deployable app
    // builds add //#env:check in their workspace turbo config; qa:release,
    // dev, and tests retain the root environment hygiene gate below.
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "E2E_COVERAGE", "NEXT_PUBLIC_*", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.example",
        ".env.local",
        ".env.staging",
        ".env.production"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "*.tsbuildinfo"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["//#env:check"],
      "passThroughEnv": [
        "API_PORT",
        "APP_PORT",
        "DOCS_PORT",
        "FILES_PORT",
        "MCP_PORT",
        "NOTIFICATIONS_PORT",
        "PORTLESS_URL",
        "WEBSITE_PORT"
      ],
      "persistent": true
    },
    "dev:debug": {
      "cache": false,
      "dependsOn": ["//#env:check"],
      "passThroughEnv": [
        "API_PORT",
        "APP_PORT",
        "DOCS_PORT",
        "FILES_PORT",
        "MCP_PORT",
        "NOTIFICATIONS_PORT",
        "WEBSITE_PORT"
      ],
      "persistent": true
    },
    "dev:process": {
      "cache": false,
      "dependsOn": ["//#env:check"],
      "passThroughEnv": [
        "API_PORT",
        "APP_PORT",
        "DOCS_PORT",
        "FILES_PORT",
        "MCP_PORT",
        "NOTIFICATIONS_PORT",
        "PORTLESS_URL",
        "WEBSITE_PORT"
      ],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/tsconfig.typecheck.base.json"
      ]
    },
    "test": {
      "dependsOn": ["//#env:check", "^build"],
      "env": ["TZ", "WORKFLOW_BILLING_TEST_DATABASE_URL", "CRUN_TEST_REDIS_URL"]
    },
    "test:shard": {
      "dependsOn": ["//#env:check", "^build"],
      "env": ["TZ"]
    },
    // Workers cron specs live in their own Vitest config (vitest.cron.config.ts);
    // CI runs it on the server leg of the Test Workspaces job.
    "test:cron": {
      "dependsOn": ["//#env:check", "^build"],
      "env": ["TZ"]
    },
    "test:e2e": {
      "dependsOn": ["//#env:check", "^build"],
      "env": ["TZ"]
    },
    // Composite gate (lint + type-check + test + smoke). It must declare
    // `^build` itself: invoked outside turbo, the inner `tsc` sees no built
    // `dist/*.d.ts` for the workspace packages it resolves through, and every
    // one of them fails with TS2307.
    "qa:release": {
      "cache": false,
      "dependsOn": ["//#env:check", "^build"],
      "env": ["GENFEED_DESKTOP_RELEASE", "TZ"]
    },
    "clean": {
      "cache": false
    },
    // The graph scanner reads repository files directly, including excluded
    // bridge nodes. Hash every app/package file, not just selected workspaces.
    "//#check:import-cycles": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/**",
        "packages/**",
        "scripts/check-import-cycles.ts",
        "scripts/import-cycle-baseline.json",
        "!apps/**/node_modules/**",
        "!packages/**/node_modules/**",
        "!apps/**/.turbo/**",
        "!packages/**/.turbo/**",
        "!apps/**/.next/**"
      ],
      "env": ["CI", "CI_CHECK_RUNTIME"],
      "outputs": []
    },
    "//#env:check": {
      "cache": false,
      "inputs": [
        ".env.example",
        ".env.local",
        ".env.staging",
        ".env.production",
        "scripts/env-check.ts",
        "scripts/env-spec.ts"
      ]
    }
  }
}
