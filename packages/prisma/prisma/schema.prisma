model LifecycleEmailPreference {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id])
  unsubscribeToken        String    @unique
  marketingUnsubscribedAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@map("lifecycle_email_preferences")
}

model LifecycleEmailDelivery {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  email         String
  sequence      String
  step          String
  triggerKey    String
  status        String    @default("scheduled")
  scheduledFor  DateTime
  sentAt        DateTime?
  skippedAt     DateTime?
  canceledAt    DateTime?
  failureReason String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, sequence, step, triggerKey], map: "lifecycle_email_deliveries_unique_step")
  @@index([status, scheduledFor], map: "lifecycle_email_deliveries_due_idx")
  @@index([triggerKey], map: "lifecycle_email_deliveries_trigger_idx")
  @@map("lifecycle_email_deliveries")
}

/// Immutable product event used as the durable source for notification fan-out.
model NotificationEvent {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id])
  eventKey         String
  deduplicationKey String                 @unique
  sourceType       String
  sourceId         String
  actorUserId      String?
  payload          Json
  occurredAt       DateTime
  isDeleted        Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deliveries       NotificationDelivery[]

  @@index([organizationId, eventKey, occurredAt(sort: Desc)], map: "notification_events_org_key_occurred_idx")
  @@index([sourceType, sourceId], map: "notification_events_source_idx")
  @@map("notification_events")
}

/// Account-level subscription to a typed notification topic and channel.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  topic     String
  channel   String
  isEnabled Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topic, channel], map: "notification_preferences_user_topic_channel_key")
  @@index([userId, isDeleted], map: "notification_preferences_user_deleted_idx")
  @@map("notification_preferences")
}

/// Durable per-recipient delivery state. Redis jobs only wake this record up.
model NotificationDelivery {
  id                String            @id @default(cuid())
  eventId           String
  event             NotificationEvent @relation(fields: [eventId], references: [id])
  userId            String
  user              User              @relation(fields: [userId], references: [id])
  organizationId    String
  organization      Organization      @relation(fields: [organizationId], references: [id])
  topic             String
  channel           String
  provider          String
  status            String            @default("pending")
  attemptCount      Int               @default(0)
  nextAttemptAt     DateTime          @default(now())
  lockedAt          DateTime?
  deliveredAt       DateTime?
  skippedAt         DateTime?
  providerMessageId String?
  lastError         String?
  idempotencyKey    String            @unique
  isDeleted         Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([eventId, userId, channel], map: "notification_deliveries_event_user_channel_key")
  @@index([status, nextAttemptAt, isDeleted], map: "notification_deliveries_due_idx")
  @@index([organizationId, userId, createdAt(sort: Desc)], map: "notification_deliveries_org_user_created_idx")
  @@map("notification_deliveries")
}

model CreditBalance {
  id               String          @id @default(cuid())
  // Active organization ownership is enforced by the partial SQL index
  // credit_balances_organizationId_active_key so soft-deleted history remains.
  organizationId   String?
  organization     Organization?   @relation(fields: [organizationId], references: [id])
  billingAccountId String?
  billingAccount   BillingAccount? @relation(fields: [billingAccountId], references: [id])
  balance          Float           @default(0)
  heldAmount       Float           @default(0)
  version          Int             @default(0)
  isDeleted        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([billingAccountId, isDeleted])
  @@map("credit_balances")
}

model CreditTransaction {
  id                   String             @id @default(cuid())
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  billingAccountId     String?
  billingAccount       BillingAccount?    @relation(fields: [billingAccountId], references: [id])
  actorUserId          String?
  reservationId        String?
  reservation          CreditReservation? @relation(fields: [reservationId], references: [id])
  idempotencyKey       String?
  amount               Float
  balanceAfter         Float?
  source               String?
  description          String?
  referenceId          String?
  referenceType        String?
  metadata             Json?
  category             String?
  isDeleted            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  referralRewardGrants ReferralReward[]   @relation("referral_reward_grant_transaction")

  @@index([source, isDeleted, createdAt(sort: Desc)], map: "credit_transactions_source_deleted_created_at_idx")
  @@index([source, isDeleted, organizationId, createdAt(sort: Desc)], map: "credit_transactions_source_deleted_org_created_at_idx")
  @@index([organizationId, isDeleted, category, createdAt(sort: Desc)], map: "credit_transactions_org_deleted_category_created_at_idx")
  @@index([billingAccountId, isDeleted, createdAt(sort: Desc)])
  @@index([reservationId])
  @@map("credit_transactions")
}

model BillingAccount {
  id               String               @id @default(cuid())
  label            String?
  stripeCustomerId String?
  status           BillingAccountStatus @default(UNPROVISIONED)
  planTier         String?
  isDeleted        Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  members             BillingAccountMember[]
  organizationLinks   BillingAccountOrganization[]
  organizations       Organization[]
  customers           Customer[]
  subscriptions       Subscription[]
  creditBalances      CreditBalance[]
  creditTransactions  CreditTransaction[]
  creditReservations  CreditReservation[]
  referralCodes       ReferralCode[]               @relation("referral_code_reward_billing_account")
  referralsAsReferrer Referral[]                   @relation("referral_referrer_billing_account")
  referralsAsReferred Referral[]                   @relation("referral_referred_billing_account")

  @@index([status, isDeleted])
  @@map("billing_accounts")
}

/// Shareable, opaque referral identity. The reward destination is pinned when
/// the code is created so later organization switching cannot redirect rewards.
model ReferralCode {
  id                     String         @id @default(cuid())
  ownerUserId            String
  ownerUser              User           @relation(fields: [ownerUserId], references: [id])
  rewardBillingAccountId String
  rewardBillingAccount   BillingAccount @relation("referral_code_reward_billing_account", fields: [rewardBillingAccountId], references: [id])
  rewardOrganizationId   String
  rewardOrganization     Organization   @relation("referral_code_reward_organization", fields: [rewardOrganizationId], references: [id])
  code                   String         @unique
  isActive               Boolean        @default(true)
  isDeleted              Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  referrals              Referral[]
  rewards                ReferralReward[]

  @@unique([ownerUserId, rewardBillingAccountId], map: "referral_codes_owner_billing_account_key")
  @@index([rewardBillingAccountId, isDeleted])
  @@index([rewardOrganizationId, isDeleted])
  @@map("referral_codes")
}

/// Immutable first-touch attribution between two billing accounts.
model Referral {
  id                       String           @id @default(cuid())
  codeId                   String
  code                     ReferralCode     @relation(fields: [codeId], references: [id])
  referrerBillingAccountId String
  referrerBillingAccount   BillingAccount   @relation("referral_referrer_billing_account", fields: [referrerBillingAccountId], references: [id])
  referredBillingAccountId String
  referredBillingAccount   BillingAccount   @relation("referral_referred_billing_account", fields: [referredBillingAccountId], references: [id])
  referrerOrganizationId   String
  referrerOrganization     Organization     @relation("referral_referrer_organization", fields: [referrerOrganizationId], references: [id])
  referredOrganizationId   String
  referredOrganization     Organization     @relation("referral_referred_organization", fields: [referredOrganizationId], references: [id])
  status                   ReferralStatus   @default(ACTIVE)
  attributedAt             DateTime         @default(now())
  rewardEndsAt             DateTime
  isDeleted                Boolean          @default(false)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  rewards                  ReferralReward[]

  @@index([codeId, status, isDeleted])
  @@index([referrerBillingAccountId, status, isDeleted])
  @@index([referredOrganizationId, isDeleted])
  @@map("referrals")
}

/// Durable reward settlement record. Stripe events and scheduled settlement
/// converge on this row; Redis or cron is only a wake-up mechanism.
model ReferralReward {
  id                      String               @id @default(cuid())
  referralId              String
  referral                Referral             @relation(fields: [referralId], references: [id])
  referralCodeId          String
  referralCode            ReferralCode         @relation(fields: [referralCodeId], references: [id])
  stripeCheckoutSessionId String               @unique
  stripePaymentIntentId   String?
  grossAmountCents        Int
  netAmountCents          Int
  purchasedCredits        Int
  refundedAmountCents     Int                  @default(0)
  rewardCredits           Int
  reversedCredits         Int                  @default(0)
  status                  ReferralRewardStatus @default(PENDING)
  eligibleAt              DateTime
  nextAttemptAt           DateTime
  attemptCount            Int                  @default(0)
  lockedAt                DateTime?
  grantedAt               DateTime?
  cancelledAt             DateTime?
  reversedAt              DateTime?
  failureReason           String?
  grantTransactionId      String?              @unique
  grantTransaction        CreditTransaction?   @relation("referral_reward_grant_transaction", fields: [grantTransactionId], references: [id])
  isDeleted               Boolean              @default(false)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([status, nextAttemptAt, isDeleted])
  @@index([stripePaymentIntentId, isDeleted])
  @@index([referralId, createdAt(sort: Desc)])
  @@index([referralCodeId, createdAt(sort: Desc)])
  @@index([referralCodeId, status, isDeleted])
  @@map("referral_rewards")
}

model BillingAccountMember {
  id               String                   @id @default(cuid())
  billingAccountId String
  billingAccount   BillingAccount           @relation(fields: [billingAccountId], references: [id])
  userId           String
  user             User                     @relation(fields: [userId], references: [id])
  role             BillingAccountMemberRole
  isDeleted        Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([billingAccountId, userId])
  @@index([userId, isDeleted])
  @@map("billing_account_members")
}

model BillingAccountOrganization {
  id                   String                           @id @default(cuid())
  billingAccountId     String
  billingAccount       BillingAccount                   @relation(fields: [billingAccountId], references: [id])
  organizationId       String
  organization         Organization                     @relation(fields: [organizationId], references: [id])
  status               BillingAccountOrganizationStatus @default(LINKED)
  monthlyBudgetCredits Float?
  budgetPolicy         String?
  linkedAt             DateTime                         @default(now())
  detachedAt           DateTime?
  isDeleted            Boolean                          @default(false)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt

  @@index([billingAccountId, status, isDeleted])
  @@index([organizationId, status, isDeleted])
  @@map("billing_account_organizations")
}

model CreditReservation {
  id               String                  @id @default(cuid())
  billingAccountId String
  billingAccount   BillingAccount          @relation(fields: [billingAccountId], references: [id])
  organizationId   String
  organization     Organization            @relation(fields: [organizationId], references: [id])
  actorUserId      String?
  amount           Float
  settledAmount    Float?
  status           CreditReservationStatus @default(RESERVED)
  workloadType     String?
  workloadId       String?
  idempotencyKey   String
  expiresAt        DateTime
  isDeleted        Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  settlements      CreditTransaction[]

  @@index([billingAccountId, status, isDeleted])
  @@index([organizationId, status, isDeleted])
  @@index([status, expiresAt])
  @@map("credit_reservations")
}

/// Per-completion LLM vendor cost (#2361). Micro-USD integers; BYOK rows
/// store tokens/latency with vendorCostMicros = 0. Never stores prompt or
/// completion content.
model LlmVendorCost {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  brandId          String?
  brand            Brand?       @relation("llm_vendor_cost_brand", fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  provider         String
  model            String
  promptTokens     Int          @default(0)
  completionTokens Int          @default(0)
  latencyMs        Int          @default(0)
  vendorCostMicros Int          @default(0)
  isByok           Boolean      @default(false)
  threadId         String?
  runId            String?
  isDeleted        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, isDeleted, createdAt(sort: Desc)], map: "llm_vendor_costs_org_deleted_created_at_idx")
  @@index([organizationId, brandId, isDeleted, createdAt(sort: Desc)], map: "llm_vendor_costs_org_brand_deleted_created_at_idx")
  @@index([organizationId, isDeleted, model, createdAt(sort: Desc)], map: "llm_vendor_costs_org_deleted_model_created_at_idx")
  @@map("llm_vendor_costs")
}

/// Per-generation media vendor cost (companion to LlmVendorCost, #2361).
/// Micro-USD integers derived from Model.providerCostUsd × realized output
/// units (seconds / megapixels / runs). BYOK rows store units with
/// vendorCostMicros = 0. Never stores prompt content.
model MediaVendorCost {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  brandId          String?
  brand            Brand?       @relation("media_vendor_cost_brand", fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  provider         String
  model            String
  category         String
  ingredientId     String?
  idempotencyKey   String?      @unique
  units            Float        @default(1)
  pricingType      String?
  vendorCostMicros Int          @default(0)
  isByok           Boolean      @default(false)
  isDeleted        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, isDeleted, createdAt(sort: Desc)], map: "media_vendor_costs_org_deleted_created_at_idx")
  @@index([organizationId, brandId, isDeleted, createdAt(sort: Desc)], map: "media_vendor_costs_org_brand_deleted_created_at_idx")
  @@index([organizationId, isDeleted, model, createdAt(sort: Desc)], map: "media_vendor_costs_org_deleted_model_created_at_idx")
  @@map("media_vendor_costs")
}

model CustomerInstance {
  id             String   @id @default(cuid())
  organizationId String?
  config         Json     @default("{}")
  status         String?
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isDeleted])
  @@map("customer_instances")
}

// ═══════════════════════════════════════════════════════════════
// ARTICLES & NEWSLETTERS
// ═══════════════════════════════════════════════════════════════

model Article {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  // `label`/`summary` are the domain, DTO, serializer, and wire names for an
  // article's title and excerpt (matching Brand.label, Organization.label).
  // The columns were `title`/`excerpt` until #2767; nothing outside Prisma ever
  // used those spellings, so persistence now matches the rest of the stack.
  label          String
  slug           String?
  content        String?
  summary        String?
  coverImageUrl  String?
  status         ArticleStatus @default(DRAFT)
  publishedAt    DateTime?
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags             Tag[]              @relation("article_tags")
  prompts          Prompt[]
  postEntities     Post[]             @relation("post_entity_article")
  articleAnalytics ArticleAnalytics[]
  newsletters      Newsletter[]       @relation("newsletter_articles")

  category String?
  scope    String?

  // Canonical SEO score (0-100) + structured scorecard, set by SEOScorerService (#758).
  // Distinct from the virality sub-factor `seoScore` (in-memory virality blob only).
  seoScore     Float?
  seoBreakdown Json?

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([slug])
  @@map("articles")
}

model ArticleAnalytics {
  id             String       @id @default(cuid())
  articleId      String
  article        Article      @relation(fields: [articleId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  date           DateTime
  totalViews     Int          @default(0)
  totalLikes     Int          @default(0)
  totalComments  Int          @default(0)
  totalShares    Int          @default(0)
  engagementRate Float        @default(0)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([articleId, date])
  @@index([organizationId, date(sort: Desc)])
  @@index([brandId, date(sort: Desc)])
  @@map("article_analytics")
}

model Newsletter {
  id                   String             @id @default(cuid())
  userId               String
  user                 User               @relation("newsletter_user", fields: [userId], references: [id])
  organizationId       String
  organization         Organization       @relation(fields: [organizationId], references: [id])
  brandId              String?
  brand                Brand?             @relation(fields: [brandId], references: [id])
  workflowExecutionId  String?
  workflowExecution    WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  approvedByUserId     String?
  approvedByUser       User?              @relation("newsletter_approved_by", fields: [approvedByUserId], references: [id])
  approvedVersionPinId String?
  approvedVersionPin   ContentVersionPin? @relation(fields: [approvedVersionPinId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  publishedByUserId    String?
  publishedByUser      User?              @relation("newsletter_published_by", fields: [publishedByUserId], references: [id])
  label                String
  topic                String?
  angle                String?
  summary              String?
  content              String?
  status               String             @default("draft")
  generationPrompt     String?
  sourceRefs           Json?
  contextNewsletterIds String[]           @default([])
  approvedAt           DateTime?
  publishedAt          DateTime?
  scheduledFor         DateTime?
  isDeleted            Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  articles           Article[]    @relation("newsletter_articles")
  contextNewsletters Newsletter[] @relation("newsletter_context")
  contextOf          Newsletter[] @relation("newsletter_context")

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([approvedVersionPinId], map: "newsletters_approvedVersionPinId_idx")
  @@map("newsletters")
}

// ═══════════════════════════════════════════════════════════════
// TRAININGS & MODELS
// ═══════════════════════════════════════════════════════════════

model Training {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  personaId      String?
  persona        Persona?      @relation(fields: [personaId], references: [id])
  label          String?
  description    String?
  externalId     String?
  stage          TrainingStage @default(PENDING)
  config         Json          @default("{}")
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sources     Ingredient[] @relation("training_sources")
  ingredients Ingredient[] @relation("ingredient_training")
  models      Model[]

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([brandId, isDeleted, createdAt(sort: Desc)])
  @@index([isDeleted, personaId, stage])
  @@map("trainings")
}

enum ModelLifecycle {
  RECOMMENDED
  AVAILABLE
  LEGACY
  RETIRED
}

model Model {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  trainingId     String?
  training       Training?     @relation(fields: [trainingId], references: [id])
  parentModelId  String?
  parentModel    Model?        @relation("model_parent", fields: [parentModelId], references: [id])
  childModels    Model[]       @relation("model_parent")

  key         String  @unique
  endpoint    String
  label       String
  description String?
  category    String
  provider    String
  externalId  String?
  config      Json    @default("{}")

  cost                       Float   @default(0)
  costPerUnit                Float?
  minCost                    Float?
  providerCostUsd            Float?
  inputCostPerMillionTokens  Float?
  outputCostPerMillionTokens Float?
  margin                     Float?
  pricingType                String?
  costTier                   String?
  qualityTier                String?
  speedTier                  String?

  aspectRatios          String[] @default([])
  capabilities          String[] @default([])
  durations             Int[]    @default([])
  recommendedFor        String[] @default([])
  supportsFeatures      String[] @default([])
  defaultAspectRatio    String?
  defaultDuration       Int?
  maxDimensions         Json?
  minDimensions         Json?
  maxOutputs            Int?
  maxReferences         Int?
  hasAudioToggle        Boolean?
  hasDurationEditing    Boolean?
  hasEndFrame           Boolean?
  hasInterpolation      Boolean?
  hasResolutionOptions  Boolean?
  hasSpeech             Boolean?
  isBatchSupported      Boolean?
  isImagenModel         Boolean?
  isReferencesMandatory Boolean?
  usesOrientation       Boolean?

  lifecycle     ModelLifecycle @default(AVAILABLE)
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  isDeleted     Boolean        @default(false)
  isDiscovered  Boolean        @default(false)
  isHighlighted Boolean        @default(false)
  isLegacy      Boolean        @default(false)
  isPublic      Boolean        @default(true)
  isDeprecated  Boolean        @default(false)
  isFree        Boolean        @default(false)

  deprecatedAt    DateTime?
  discoveredAt    DateTime?
  lastSyncedAt    DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewStatus    String?
  rejectionReason String?
  predecessorOf   String?
  succeededBy     String?
  trigger         String?
  triggerWord     String?

  // Provider execution contracts are reviewed snapshots. Synchronization may
  // replace only the pending version; runtime fields stay pinned to the last
  // approved contract until an operator promotes the candidate.
  reviewedProviderContractVersion String?
  pendingProviderContractVersion  String?
  providerSchemaFamily            String?
  providerInputSchema             Json?
  providerSyncStatus              String?
  providerSchemaSyncedAt          DateTime?
  providerPricingSyncedAt         DateTime?
  providerSyncFailedAt            DateTime?
  providerSyncFailureCode         String?
  providerContracts               ModelProviderContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, endpoint], map: "models_provider_endpoint_key")
  @@index([category, isActive, isDeleted])
  @@index([lifecycle, category, isActive, isDeleted])
  @@index([provider, isActive, isDeleted])
  @@index([organizationId, isActive, isDeleted])
  @@map("models")
}

/// Append-only provider metadata snapshots. Raw schemas and commercial price
/// metadata never enter model serializers; reviewed projections are copied to
/// Model only when an operator approves a supported candidate.
model ModelProviderContract {
  id                    String    @id @default(cuid())
  modelId               String
  model                 Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  provider              String
  endpoint              String
  version               String
  openapiVersion        String?
  openapi               Json
  inputSchema           Json
  outputSchema          Json
  schemaFamily          String?
  pricing               Json
  currency              String?
  billingUnit           String?
  unitPrice             String?
  unitPriceMicros       BigInt?
  conditionalDimensions Json      @default("{}")
  pricingType           String?
  mappingStatus         String
