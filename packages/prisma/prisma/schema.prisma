model User {
  knowledgeSources KnowledgeSource[]
  knowledgeSpaces KnowledgeSpace[]
  id                       String          @id @default(cuid())
  handle                   String          @unique
  firstName                String?
  lastName                 String?
  email                    String?         @unique
  avatar                   String?
  // Better Auth (epic #735, dual-run beside legacy auth provider). `name`/`emailVerified` are
  // the BA core user fields (BA `image` maps onto `avatar` above via config).
  // Platform access is explicit and separate from organization/member roles.
  name                     String?
  emailVerified            Boolean         @default(false)
  // Better Auth Infra dash activity tracking. Nullable for users that predate tracking.
  lastActiveAt             DateTime?
  platformRole             PlatformRole    @default(USER)
  // Better Auth admin plugin (#2423). The plugin's `role` field maps onto
  // `platformRole` above (one role system); ban state is plugin-owned
  // moderation state checked on session creation.
  banned                   Boolean         @default(false)
  banReason                String?
  banExpires               DateTime?
  isDefault                Boolean         @default(false)
  isDeleted                Boolean         @default(false)
  isInvited                Boolean         @default(false)
  isOnboardingCompleted    Boolean         @default(false)
  onboardingStartedAt      DateTime?
  onboardingCompletedAt    DateTime?
  onboardingType           OnboardingType?
  onboardingStepsCompleted String[]        @default([])
  // First-asset unlock gate (cloud SaaS): per-user "explore anyway" escape hatch
  // that permanently clears the locked nav/teaser state even before the org has
  // generated its first asset. Org-level unlock signal lives on OrganizationSetting.
  hasDismissedAssetGate    Boolean         @default(false)
  appSource                AppSource       @default(GENFEED)
  stripeCustomerId         String?
  // Active-organization pointer (epic #735, Phase C). Replaces the legacy auth provider
  // `publicMetadata.organization` routing candidate so the user's current org
  // survives the legacy auth provider cutover and multi-org switching is DB-authoritative for
  // both the legacy auth provider and Better Auth identity resolvers. Plain id (validated
  // against live membership at resolve time); no FK so leaving/deleting an org
  // never blocks. Brand stays per-membership via `Member.lastUsedBrandId`.
  lastUsedOrganizationId   String?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  // Ownership relations (what this user owns)
  organizations             Organization[]
  brands                    Brand[]
  members                   Member[]
  invitationsSent           Invitation[]              @relation("invitation_invited_by")
  invitationsAccepted       Invitation[]              @relation("invitation_accepted_by")
  sessions                  Session[]
  accounts                  Account[]
  settings                  Setting?
  credentials               Credential[]
  apiKeys                   ApiKey[]
  ingredients               Ingredient[]
  campaigns                 Campaign[]
  campaignPaidActivations   CampaignPaidActivation[]
  posts                     Post[]
  postGroups                PostGroup[]
  postingCadences           PostingCadence[]
  postAnalytics             PostAnalytics[]
  prompts                   Prompt[]
  folders                   Folder[]
  bookmarks                 Bookmark[]
  articles                  Article[]
  articleAnalytics          ArticleAnalytics[]
  newsletters               Newsletter[]              @relation("newsletter_user")
  newsletterApprovals       Newsletter[]              @relation("newsletter_approved_by")
  newsletterPublishes       Newsletter[]              @relation("newsletter_published_by")
  trainings                 Training[]
  personas                  Persona[]
  agentStrategies           AgentStrategy[]
  agentCampaigns            AgentCampaign[]
  agentGoals                AgentGoal[]
  agentMemories             AgentMemory[]
  agentThreads              AgentThread[]
  agentMessages             AgentMessage[]
  agentTransfers            AgentTransfer[]
  socialConversations       SocialConversation[]
  socialMessages            SocialMessage[]
  agentWorkflows            AgentWorkflow[]
  workflows                 Workflow[]
  workflowVersions          WorkflowVersion[]
  workflowExecutions        WorkflowExecution[]
  promotedWorkflowArtifacts WorkflowArtifact[]        @relation("workflow_artifact_promoted_by")
  bots                      Bot[]
  livestreamBotSessions     LivestreamBotSession[]
  botActivities             BotActivity[]
  replyBotConfigs           ReplyBotConfig[]
  monitoredAccounts         MonitoredAccount[]
  socialSources             SocialSource[]
  sourcePosts               SourcePost[]
  listeningTopics           ListeningTopic[]
  listeningThemeReviews     ListeningTheme[]          @relation("listening_theme_reviewed_by")
  socialWarmupEnrollments   SocialWarmupEnrollment[]
  socialWarmupEvents        SocialWarmupEvent[]
  votes                     Vote[]
  watchlists                Watchlist[]
  postingSets               PostingSet[]
  postingSignatures         PostingSignature[]
  rssSources                RssSource[]
  rssFeedItems              RssFeedItem[]
  engagementRules           EngagementRule[]
  agentPublishAudits        AgentPublishAudit[]
  streaks                   Streak[]
  forecasts                 Forecast[]
  tasks                     Task[]
  contentPlans              ContentPlan[]
  evaluations               Evaluation[]
  editorProjects            EditorProject[]
  batches                   Batch[]
  assignedBatchItems        BatchItem[]               @relation("batch_item_assignee")
  assets                    Asset[]
  subscriptions             Subscription[]
  userSubscription          UserSubscription?
  subscriptionAttributions  SubscriptionAttribution[]
  distributions             Distribution[]
  creatorAnalyses           CreatorAnalysis[]
  profiles                  Profile[]
  contextBases              ContextBase[]
  optimizations             Optimization[]
  leads                     Lead[]                    @relation("lead_user")
  outreachCampaigns         OutreachCampaign[]
  captions                  Caption[]
  clipProjects              ClipProject[]
  clipResults               ClipResult[]
  personaAssignments        Persona[]                 @relation("persona_assigned_members")
  mcpApprovals              McpApproval[]
  brandInterviews           BrandInterview[]
  warmupAccountsOperated    WarmupAccount[]           @relation("warmup_account_operator")
  warmupAccountsCustomer    WarmupAccount[]           @relation("warmup_account_customer")
  lifecycleEmailPreference  LifecycleEmailPreference?
  lifecycleEmailDeliveries  LifecycleEmailDelivery[]
  notificationPreferences   NotificationPreference[]
  notificationDeliveries    NotificationDelivery[]
  contentVersionPins        ContentVersionPin[]
  publishApprovals          PublishApproval[]
  studioLooks               StudioLook[]
  savedAds                  SavedAd[]
  billingAccountMembers     BillingAccountMember[]
  referralCodes             ReferralCode[]

  @@index([isDefault])
  @@index([appSource])
  @@index([stripeCustomerId])
  @@map("users")
}

