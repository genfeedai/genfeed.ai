  @@index([organizationId, isDeleted, type])
  @@index([organizationId, earnedAt(sort: Desc)])
  @@map("fanvue_earnings")
}

model FanvueSchedule {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  contentId      String?
  content        FanvueContent? @relation(fields: [contentId], references: [id])
  status         String?
  scheduledAt    DateTime?
  data           Json           @default("{}")
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, isDeleted, status])
  @@index([scheduledAt, status])
  @@map("fanvue_schedules")
}

model FanvueSubscriber {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  externalId     String?
  status         String?
  data           Json     @default("{}")
  isDeleted      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, externalId])
  @@index([organizationId, isDeleted, status])
  @@map("fanvue_subscribers")
}

model LivestreamBotSession {
  id             String        @id @default(cuid())
  botId          String?
  bot            Bot?          @relation(fields: [botId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  data           Json          @default("{}")
  isDeleted      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, isDeleted])
  @@index([organizationId, botId, isDeleted])
  @@map("livestream_bot_sessions")
}

model Analytic {
  id        String   @id @default(cuid())
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("analytics")
}

model DesktopThread {
  id             String           @id
  userId         String?          @map("user_id")
  organizationId String?          @map("organization_id")
  localUserId    String?          @map("local_user_id")
  title          String           @default("New conversation")
  status         String           @default("idle")
  workspaceId    String?
  createdAt      DateTime
  updatedAt      DateTime
  messages       DesktopMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([organizationId, userId, updatedAt(sort: Desc)])
  @@index([organizationId, userId, updatedAt, id], map: "desktop_threads_org_user_updated_at_id_idx")
  @@map("desktop_threads")
}

model DesktopMessage {
  id               String        @id
  threadId         String
  role             String
  content          String
  createdAt        DateTime
  draftId          String?
  generatedContent Json?
  thread           DesktopThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([threadId, createdAt, id])
  @@map("desktop_messages")
}

/// Reusable scheduler channel group. Targets stay JSON so a later-deleted
/// credential degrades validation instead of breaking the row via FK.
model PostingSet {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  label          String
  description    String?
  isEnabled      Boolean      @default(true)
  targets        Json         @default("[]")
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  postGroups     PostGroup[]

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([organizationId, brandId, isDeleted, createdAt(sort: Desc)])
  @@index([userId, isDeleted, createdAt(sort: Desc)])
  @@map("posting_sets")
}

/// Reusable per-platform signature. Referenced from posting-set targets by id.
model PostingSignature {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  label          String
  body           String
  placement      String       @default("append")
  platforms      String[]     @default([])
  isEnabled      Boolean      @default(true)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([organizationId, brandId, isDeleted, createdAt(sort: Desc)])
  @@index([userId, isDeleted, createdAt(sort: Desc)])
  @@map("posting_signatures")
}

/// RSS feed configuration. Polling is a scheduler-owned sweep, not a workflow node.
model RssSource {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?          @relation(fields: [brandId], references: [id])
  label          String
  feedUrl        String
  importPolicy   RssImportPolicy @default(DRAFT)
  approvalMode   RssApprovalMode @default(APPROVAL)
  timezone       String          @default("UTC")
  targetChannels Json            @default("[]")
  isEnabled      Boolean         @default(true)
  lastPolledAt   DateTime?
  lastError      String?
  importedCount  Int             @default(0)
  skippedCount   Int             @default(0)
  failedCount    Int             @default(0)
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          RssFeedItem[]
  postGroups     PostGroup[]

  @@index([organizationId, isDeleted, isEnabled, createdAt(sort: Desc)])
  @@index([organizationId, brandId, isDeleted, createdAt(sort: Desc)])
  @@index([userId, isDeleted, createdAt(sort: Desc)])
  @@map("rss_sources")
}

/// Deduplicated feed item. Unique per source + guid (or URL fallback).
model RssFeedItem {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?            @relation(fields: [brandId], references: [id])
  rssSourceId    String
  rssSource      RssSource         @relation(fields: [rssSourceId], references: [id])
  guid           String
  url            String
  title          String
  summary        String?
  imageUrl       String?
  publishedAt    DateTime?
  status         RssFeedItemStatus @default(PENDING)
  postGroupId    String?
  error          String?
  isDeleted      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([rssSourceId, guid])
  @@index([organizationId, isDeleted, status, createdAt(sort: Desc)])
  @@index([rssSourceId, isDeleted, status])
  @@map("rss_feed_items")
}

/// Engagement-triggered automation attached to a published release target.
model EngagementRule {
  id                 String               @id @default(cuid())
  userId             String
  user               User                 @relation(fields: [userId], references: [id])
  organizationId     String
  organization       Organization         @relation(fields: [organizationId], references: [id])
  brandId            String?
  brand              Brand?               @relation(fields: [brandId], references: [id])
  postGroupId        String
  postGroup          PostGroup            @relation(fields: [postGroupId], references: [id])
  targetId           String
  metric             EngagementMetric
  threshold          Float
  windowEndsAt       DateTime?
  actionType         EngagementRuleAction
  actionPayload      Json                 @default("{}")
  mode               EngagementRuleMode   @default(APPROVAL)
  state              EngagementRuleState  @default(ARMED)
  isEnabled          Boolean              @default(true)
  triggeredAt        DateTime?
  metricSnapshot     Json?
  resultingReleaseId String?
  lastError          String?
  isDeleted          Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([organizationId, isDeleted, state, isEnabled])
  @@index([organizationId, postGroupId, isDeleted])
  @@index([targetId, isDeleted, state])
  @@map("engagement_rules")
}

/// Queryable audit of every agent-initiated publish policy decision.
model AgentPublishAudit {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  brandId             String?
  brand               Brand?               @relation(fields: [brandId], references: [id])
  postGroupId         String?
  postGroup           PostGroup?           @relation(fields: [postGroupId], references: [id])
  workflowExecutionId String?
  workflowExecution   WorkflowExecution?   @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  agentThreadId       String?
  agentStrategyId     String?
  autonomyMode        String
  channel             String?
  policyName          String
  decision            AgentPublishDecision
  reason              String
  isDeleted           Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([postGroupId, isDeleted, createdAt(sort: Desc)])
  @@index([workflowExecutionId, isDeleted])
  @@map("agent_publish_audits")
}

enum KnowledgeSourceKind {
  TEXT
  URL
  FILE
  DOCUMENT
  VIDEO
  AUDIO
  RSS
}

enum KnowledgeSourcePurpose {
  BRAND_TRUTH
  INSPIRATION
  RESEARCH
}

enum KnowledgeProcessingState {
  QUEUED
  PROCESSING
  READY
  FAILED
}

enum KnowledgeRetrievalState {
  ACTIVE
  STALE
  CONTRADICTED
  SUPERSEDED
  QUARANTINED
  EXPIRED
}

enum KnowledgeRetentionState {
  RETAINED
  SCHEDULED_FOR_PURGE
  PAYLOAD_PURGED
  POLICY_ERASED
}

enum KnowledgeRetentionPolicy {
  KEEP
  UNTIL_EXPIRY
}

model KnowledgeSource {
  id             String                     @id @default(uuid())
  organizationId String
  brandId        String?
  userId         String
  scope          String
  title          String
  kind           KnowledgeSourceKind
  purpose        KnowledgeSourcePurpose
  isVisible      Boolean                    @default(true)
  isDeleted      Boolean                    @default(false)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?                     @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  versions       KnowledgeSourceVersion[]
  memberships    KnowledgeSpaceMembership[]

  @@unique([id, organizationId])
  @@index([organizationId, isDeleted, scope, brandId])
  @@map("knowledge_sources")
}

model KnowledgeSourceVersion {
  id                    String                   @id @default(uuid())
  organizationId        String
  sourceId              String
  version               Int
  contentHash           String
  provenance            Json?
  payload               Json?
  processingState       KnowledgeProcessingState @default(QUEUED)
  retrievalState        KnowledgeRetrievalState  @default(ACTIVE)
  retentionState        KnowledgeRetentionState  @default(RETAINED)
  retentionPolicy       KnowledgeRetentionPolicy @default(KEEP)
  observedAt            DateTime
  verifiedAt            DateTime?
  expiresAt             DateTime?
  purgeScheduledAt DateTime?
  purgedAt              DateTime?
  supersededByVersionId String?
  isCurrent             Boolean                  @default(true)
  isDeleted             Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  source                KnowledgeSource          @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  supersededByVersion KnowledgeSourceVersion? @relation("KnowledgeVersionSupersession", fields: [supersededByVersionId, sourceId, organizationId], references: [id, sourceId, organizationId], onDelete: Restrict, onUpdate: NoAction, map: "knowledge_version_supersession_fkey")
  supersedesVersions KnowledgeSourceVersion[] @relation("KnowledgeVersionSupersession")
  @@unique([sourceId, version])
  @@unique([id, sourceId, organizationId])
  @@index([organizationId, sourceId, isDeleted, isCurrent], map: "knowledge_source_versions_scope_current_idx")
  @@map("knowledge_source_versions")
}

model KnowledgeSpace {
  id             String                     @id @default(uuid())
  organizationId String
  brandId        String?
  userId         String
  scope          String
  title          String
  isInbox        Boolean                    @default(false)
  isDeleted      Boolean                    @default(false)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  brand          Brand?                     @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  memberships    KnowledgeSpaceMembership[]

  @@unique([id, organizationId])
  @@index([organizationId, isDeleted, scope, brandId])
  @@map("knowledge_spaces")
}

model KnowledgeSpaceMembership {
  id             String          @id @default(uuid())
  organizationId String
  sourceId       String
  spaceId        String
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  source         KnowledgeSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  space          KnowledgeSpace  @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([spaceId, sourceId])
  @@index([organizationId, sourceId, isDeleted], map: "knowledge_memberships_scope_source_idx")
  @@map("knowledge_space_memberships")
}

// Successful one-time data upgrades. Written in the same transaction as the repair.
model DataBackfill {
  id          String   @id
  completedAt DateTime @default(now())
  report      Json

  @@map("data_backfills")
}
