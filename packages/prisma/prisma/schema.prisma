  organizationId              String
  organization                Organization              @relation(fields: [organizationId], references: [id])
  userId                      String
  user                        User                      @relation(fields: [userId], references: [id])
  sourceBrandId               String?
  sourceBrand                 Brand?                    @relation("agent_transfer_source_brand", fields: [sourceBrandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  destinationBrandId          String?
  destinationBrand            Brand?                    @relation("agent_transfer_destination_brand", fields: [destinationBrandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  sourceThreadId              String
  sourceThread                AgentThread               @relation("agent_transfer_source_thread", fields: [sourceThreadId], references: [id])
  destinationThreadId         String
  destinationThread           AgentThread               @relation("agent_transfer_destination_thread", fields: [destinationThreadId], references: [id])
  sourceMessageId             String?
  destinationMessageId        String?
  destinationExecutionId      String?                   @unique
  destinationExecution        WorkflowExecution?        @relation(fields: [destinationExecutionId], references: [id], onDelete: SetNull)
  deliveryMode                AgentTransferDeliveryMode
  status                      AgentTransferStatus       @default(PENDING)
  idempotencyKey              String
  requestHash                 String
  correlationId               String                    @unique
  parentCorrelationId         String?
  depth                       Int                       @default(0)
  content                     String
  selectedContext             Json                      @default("{}")
  artifactReferences          Json                      @default("[]")
  artifactVersionPinIds       String[]                  @default([])
  completionSummary           String?
  outputArtifactReferences    Json                      @default("[]")
  outputArtifactVersionPinIds String[]                  @default([])
  failureReason               String?
  progress                    Int                       @default(0)
  retryCount                  Int                       @default(0)
  deliveredAt                 DateTime?
  queuedAt                    DateTime?
  startedAt                   DateTime?
  completedAt                 DateTime?
  lastAttemptAt               DateTime?
  isDeleted                   Boolean                   @default(false)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  @@unique([organizationId, userId, idempotencyKey], map: "agent_transfers_org_user_idempotency_key")
  @@index([organizationId, userId, sourceThreadId, isDeleted, createdAt(sort: Desc)], map: "agent_transfers_source_thread_idx")
  @@index([organizationId, userId, destinationThreadId, isDeleted, createdAt(sort: Desc)], map: "agent_transfers_destination_thread_idx")
  @@index([organizationId, destinationExecutionId, isDeleted], map: "agent_transfers_destination_execution_idx")
