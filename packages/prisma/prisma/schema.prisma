  lastExecutedAt    DateTime?
  isDeleted         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Denormalized for the partial unique constraint that enforces at-most-one
  // default recurring workflow per (brand, org, contentType). NULL for every
  // non-default-recurring workflow. Set by `DefaultRecurringContentService`
  // on creation; enforced by the DB-level partial unique index
  // `workflows_default_recurring_brand_org_type_uidx` (see migration
  // 20260629202231). Prisma cannot express partial unique indexes in schema.prisma,
  // so the index lives only in the migration; this field documents its purpose.
  defaultRecurringBrandId String?

  tags       Tag[]               @relation("workflow_tags")
  versions   WorkflowVersion[]   @relation("workflow_versions")
  executions WorkflowExecution[]

  // Narrows predicate locks on the default-recurring-workflow re-check from a
  // relation-level SIReadLock to a page-level lock, preventing unrelated
  // concurrent writes to `workflows` (different org/brand) from aborting the
  // Serializable transaction with a false-positive P2034.
  @@index([organizationId, isDeleted])
  @@index([organizationId, brandId, isDeleted])
  // Supporting index for the partial unique constraint lookup.
  @@index([defaultRecurringBrandId, organizationId])
  @@map("workflows")
}

/// Immutable executable workflow definition. A version is append-only: edits
/// create a new row and atomically move Workflow.currentVersionId.
model WorkflowVersion {
  id             String       @id @default(cuid())
  workflowId     String
  workflow       Workflow     @relation("workflow_versions", fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  version        Int
  graph          Json
  inputSchema    Json         @default("[]")
  contentHash    String
  createdAt      DateTime     @default(now())

  currentFor        Workflow?                  @relation("workflow_current_version")
  executions        WorkflowExecution[]
  nodeContinuations WorkflowNodeContinuation[]

  @@unique([workflowId, version])
  @@index([organizationId, workflowId, version(sort: Desc)])
  @@map("workflow_versions")
}

model WorkflowExecution {
  id                String                  @id @default(cuid())
  idempotencyKey    String?
  workflowId        String
  workflow          Workflow                @relation(fields: [workflowId], references: [id])
  workflowVersionId String
  workflowVersion   WorkflowVersion         @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  userId            String
  user              User                    @relation(fields: [userId], references: [id])
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id])
  status            WorkflowExecutionStatus @default(PENDING)
  result            Json?
  error             String?
  startedAt         DateTime?
  completedAt       DateTime?
  isDeleted         Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  /// Scalar progress/ETA so node transitions do not rewrite `result` JSON (#2512).
  progress             Int       @default(0)
  durationMs           Int?
  creditsUsed          Int       @default(0)
  failedNodeId         String?
  totalNodes           Int?
  estimatedDurationMs  Int?
  remainingDurationMs  Int?
  etaConfidence        String?
  etaCurrentPhase      String?
  etaUpdatedAt         DateTime?
  scrubAllNodePayloads Boolean   @default(false)
  scrubNodeIds         String[]  @default([])
  payloadScrubbedAt    DateTime?
  purgeAfterHours      Int?
  purgeAt              DateTime?

  posts                    Post[]
  nodeResults              WorkflowExecutionNodeResult[]
  artifacts                WorkflowArtifact[]
  nodeContinuations        WorkflowNodeContinuation[]
  workspaceTasks           Task[]                        @relation("task_linked_executions")
  ingredients              Ingredient[]
  newsletters              Newsletter[]
  captions                 Caption[]
  destinationAgentTransfer AgentTransfer?
  agentPublishAudits       AgentPublishAudit[]
  clipGenerationProject    ClipProject?                  @relation("clip_generation_workflow_execution")
  clipContinuityProject    ClipProject?                  @relation("clip_continuity_workflow_execution")

  trigger String?

  @@unique([organizationId, idempotencyKey], map: "workflow_executions_org_idempotency_key")
  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([organizationId, workflowVersionId, createdAt(sort: Desc)])
  @@index([purgeAt, payloadScrubbedAt, isDeleted], map: "workflow_executions_purgeAt_idx")
  @@map("workflow_executions")
}

/// Per-node execution results, unique on (executionId, nodeId). One upsert
/// per transition — the execution `result` JSON is no longer rewritten (#2512).
model WorkflowExecutionNodeResult {
  id             String            @id @default(cuid())
  organizationId String
  executionId    String
  execution      WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId         String
  nodeType       String
  status         String
  input          Json?
  output         Json?
  error          String?
  startedAt      DateTime?
  completedAt    DateTime?
  progress       Int?
  retryCount     Int?
  creditsUsed    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([executionId, nodeId])
  @@index([organizationId, executionId])
  @@map("workflow_execution_node_results")
}

/// Internal lifecycle metadata for temporary objects produced by workflow
/// nodes. Durable Library assets remain in Asset/Ingredient; this row only
/// owns deletion or an explicit promotion handoff for temporary storage.
model WorkflowArtifact {
  id                  String                @id @default(cuid())
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  executionId         String
  execution           WorkflowExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nodeId              String
  storageProvider     String                @default("primary")
  storageKey          String
  kind                String
  retentionPolicy     String                @default("terminal")
  metadata            Json                  @default("{}")
  state               WorkflowArtifactState @default(ACTIVE)
  expiresAt           DateTime
  cleanupClaimedAt    DateTime?
  cleanupAttempts     Int                   @default(0)
  lastError           String?
  promotedAt          DateTime?
  promotedByUserId    String?
  promotedByUser      User?                 @relation("workflow_artifact_promoted_by", fields: [promotedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  promotionTargetType String?
  promotionTargetId   String?
  isDeleted           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([executionId, nodeId, storageProvider, storageKey], map: "workflow_artifacts_storage_identity_key")
  @@index([organizationId, executionId, state, isDeleted], map: "workflow_artifacts_execution_state_idx")
  @@index([state, retentionPolicy, expiresAt], map: "workflow_artifacts_expiry_idx")
  @@index([state, cleanupClaimedAt], map: "workflow_artifacts_cleanup_lease_idx")
  @@map("workflow_artifacts")
}

/// Durable per-node idempotency claims for workflow execution (#2359).
/// Unique on (executionId, nodeId): a second insert loses (P2002) and the
/// runner re-emits the stored output instead of re-firing side effects.
model WorkflowNodeClaim {
  id             String   @id @default(cuid())
  organizationId String
  executionId    String
  nodeId         String
  /// running | completed | failed
  status         String
  output         Json?
  error          String?
  leaseOwnerId   String?
  leaseExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([executionId, nodeId])
  @@index([organizationId, executionId])
  @@map("workflow_node_claims")
}

/// Durable ownership of an action node whose provider finishes outside the
/// process that submitted it. A continuation is created before provider
/// submission and remains bound to the exact immutable workflow version.
model WorkflowNodeContinuation {
  id                    String                         @id @default(cuid())
  organizationId        String
  organization          Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  executionId           String
  execution             WorkflowExecution              @relation(fields: [executionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workflowVersionId     String
  workflowVersion       WorkflowVersion                @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nodeId                String
  actionId              String
  ingredientId          String
  ingredient            Ingredient                     @relation(fields: [ingredientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  provider              String
  externalId            String?
  status                WorkflowNodeContinuationStatus @default(PENDING_SUBMISSION)
  initialOutput         Json?
  providerResult        Json?
  error                 String?
  creditsUsed           Int                            @default(0)
  resumeClaimedAt       DateTime?
  pollAttempt           Int?
  pollDispatchClaimedAt DateTime?
  pollDispatchedAt      DateTime?
  completedAt           DateTime?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([executionId, nodeId], map: "workflow_node_continuations_execution_node_key")
  @@unique([organizationId, ingredientId], map: "workflow_node_continuations_org_ingredient_key")
  @@unique([organizationId, provider, externalId], map: "workflow_node_continuations_org_provider_external_key")
  @@index([organizationId, executionId, status], map: "workflow_node_continuations_org_execution_status_idx")
  @@index([status, resumeClaimedAt], map: "workflow_node_continuations_resume_lease_idx")
  @@index([provider, status, pollDispatchedAt], map: "workflow_node_continuations_poll_outbox_idx")
  @@map("workflow_node_continuations")
}

model ContentRun {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
