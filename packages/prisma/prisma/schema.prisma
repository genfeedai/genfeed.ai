model OutreachCampaign {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  credentialId   String?
  credential     Credential?  @relation(fields: [credentialId], references: [id])
  // Drifted enum collapsed to String (lowercase canonical value). See Post.platform note.
  status         String       @default("draft")
  config         Json         @default("{}")
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  targets CampaignTarget[]

  platform     String?
  campaignType String?
  isActive     Boolean @default(true)

  @@unique([id, organizationId], map: "outreach_campaigns_id_organizationId_key")
  @@index([organizationId, isDeleted])
  @@index([organizationId, status, isDeleted], map: "outreach_campaigns_organizationId_status_isDeleted_idx")
  @@index([brandId, isDeleted])
  @@index([credentialId, isDeleted])
  @@map("outreach_campaigns")
}

model CampaignTarget {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  campaignId      String
  campaign        OutreachCampaign @relation(fields: [campaignId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  // String column; canonical casing is the SCREAMING CampaignTargetStatus domain vocabulary (#2543).
  status          String           @default("PENDING")
  data            Json             @default("{}")
  externalId      String?
  scheduledAt     DateTime?
  scheduleVersion Int              @default(1)
  processedAt     DateTime?
  replyExternalId String?
  replyText       String?
  replyUrl        String?
  errorMessage    String?
  retryCount      Int              @default(0)
  skipReason      String?
  isDeleted       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([campaignId, status])
  @@index([campaignId, createdAt])
  @@index([organizationId, campaignId, status, isDeleted], map: "campaign_targets_org_campaign_status_deleted_idx")
  @@index([organizationId, status, isDeleted, scheduledAt], map: "campaign_targets_org_status_deleted_scheduled_idx")
  @@map("campaign_targets")
}

