  // predicates.
  @@index([organizationId, isDeleted, createdAt(sort: Desc)], map: "ad_watched_advertisers_org_deleted_created_at_idx")
  @@index([organizationId, brandId, platform, isDeleted], map: "ad_watched_advertisers_org_brand_platform_deleted_idx")
  @@index([isDeleted, platform, lastAttemptedAt], map: "ad_watched_advertisers_deleted_platform_last_attempted_idx")
  @@map("ad_watched_advertisers")
