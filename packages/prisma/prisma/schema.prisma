  @@unique([id, organizationId, brandId, topicId], map: "listening_evidence_id_scope_topic_key")
  @@unique([topicId, platform, externalId], map: "listening_evidence_topic_platform_external_key")
  @@index([organizationId, brandId, topicId, isDeleted, occurredAt(sort: Desc)], map: "listening_evidence_topic_occurred_idx")
  @@index([topicSourceId, isDeleted, collectedAt(sort: Desc)], map: "listening_evidence_source_collected_idx")
  @@map("listening_evidence")
}

/// A deterministic, versioned cluster formed from fresh evidence inside two
/// explicit comparison windows. Evidence membership is stored in the explicit
/// ListeningThemeEvidence join rather than copied into the theme record.
model ListeningTheme {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id])
  brandId             String
  brand               Brand          @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  topicId             String
  topic               ListeningTopic @relation(fields: [topicId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Cascade, onUpdate: Cascade)
  label               String
  clusterKey          String
  methodologyVersion  String
  analysisKey         String
  currentWindowStart  DateTime
  currentWindowEnd    DateTime
  previousWindowStart DateTime
  previousWindowEnd   DateTime
  idempotencyKey      String
  reviewState         String         @default("unreviewed")
  reviewedAt          DateTime?
