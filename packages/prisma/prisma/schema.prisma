/// A tenant-owned, bounded definition of the public connector data an operator
/// wants Genfeed to monitor. Provider-specific query payloads belong in the
/// collectors; this record is the stable product contract shared by API,
/// workers, MCP, and UI consumers.
model ListeningTopic {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  brandId          String
  brand            Brand        @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id])
  label            String
  description      String?
  keywords         String[]     @default([])
  excludedKeywords String[]     @default([])
  languages        String[]     @default([])
  freshnessHours   Int          @default(24)
  fingerprint      String
  contractVersion  Int          @default(1)
  isActive         Boolean      @default(true)
  auditedAt        DateTime     @default(now())
  lastCollectedAt  DateTime?
  isDeleted        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  sources  ListeningTopicSource[]
  evidence ListeningEvidence[]
  themes   ListeningTheme[]
  signals  ListeningSignal[]

  // Active-topic uniqueness is enforced by the partial index in the migration.
  @@unique([id, organizationId, brandId], map: "listening_topics_id_scope_key")
  @@index([organizationId, brandId, fingerprint], map: "listening_topics_scope_fingerprint_idx")
  @@index([organizationId, brandId, isDeleted, isActive, createdAt(sort: Desc)], map: "listening_topics_scope_active_idx")
  @@map("listening_topics")
}

/// Explicit source membership keeps topic authorization reviewable and avoids
/// embedding provider-specific source payloads in ListeningTopic.
model ListeningTopicSource {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id])
  brandId             String
  brand               Brand          @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  topicId             String
  topic               ListeningTopic @relation(fields: [topicId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Cascade, onUpdate: Cascade)
  sourceId            String
  source              SocialSource   @relation(fields: [sourceId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Restrict, onUpdate: Cascade)
  platform            String
  collectionState     String         @default("pending")
  collectionCursor    String?
  lastCollectedAt     DateTime?
  lastCollectionError String?
  rateLimitedAt       DateTime?
  isDeleted           Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  evidence ListeningEvidence[]

  @@unique([topicId, sourceId], map: "listening_topic_sources_topic_source_key")
  @@unique([id, organizationId, brandId, topicId], map: "listening_topic_sources_id_scope_topic_key")
  @@index([organizationId, brandId, sourceId], map: "listening_topic_sources_scope_source_idx")
  @@map("listening_topic_sources")
}

/// Normalized evidence captured for a listening topic. Raw provider payloads
