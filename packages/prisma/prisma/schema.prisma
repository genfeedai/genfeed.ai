  topic              ListeningTopic       @relation(fields: [topicId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Cascade, onUpdate: Cascade)
  topicSourceId      String
  topicSource        ListeningTopicSource @relation(fields: [topicSourceId, organizationId, brandId, topicId], references: [id, organizationId, brandId, topicId], onDelete: Cascade, onUpdate: Cascade)
  sourcePostId       String?
  sourcePost         SourcePost?          @relation(fields: [sourcePostId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Restrict, onUpdate: Cascade)
  platform           String
  externalId         String
