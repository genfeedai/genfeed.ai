/// A bounded, attributable calculation. Insufficient coverage is durable and
/// observable: status explains the outcome and value remains null.
model ListeningSignal {
  id                  String          @id @default(cuid())
  organizationId      String
  organization        Organization    @relation(fields: [organizationId], references: [id])
  brandId             String
  brand               Brand           @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  topicId             String
  topic               ListeningTopic  @relation(fields: [topicId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Cascade, onUpdate: Cascade)
  themeId             String?
  theme               ListeningTheme? @relation(fields: [themeId, organizationId, brandId, topicId], references: [id, organizationId, brandId, topicId], onDelete: Cascade, onUpdate: Cascade)
  signalType          String
  status              String
  insufficiencyReason String?
  value               Float?
  confidence          Float
  methodologyVersion  String
  analysisKey         String
  currentWindowStart  DateTime
  currentWindowEnd    DateTime
  previousWindowStart DateTime
  previousWindowEnd   DateTime
  includedSourceIds   String[]        @default([])
  excludedSourceIds   String[]        @default([])
  evidenceIds         String[]        @default([])
  idempotencyKey      String
  isDeleted           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([organizationId, brandId, topicId, idempotencyKey], map: "listening_signals_scope_idempotency_key")
  @@index([organizationId, brandId, topicId, analysisKey, isDeleted], map: "listening_signals_scope_analysis_idx")
  @@index([organizationId, brandId, topicId, isDeleted, currentWindowEnd(sort: Desc)], map: "listening_signals_scope_window_idx")
  @@map("listening_signals")
}

