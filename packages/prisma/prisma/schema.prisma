  accessToken                     String?
  accessTokenSecret               String?
  accessTokenExpiry               DateTime?
  refreshToken                    String?
  refreshTokenExpiry              DateTime?
  grantedScopes                   String[]           @default([])
  grantedScopesCapturedAt         DateTime?
  label                           String?
  description                     String?
  postingTimes                    Json               @default("[]")
  warmupState                     String             @default("not_started")
  warmupScore                     Int                @default(0)
  warmupRiskLevel                 String             @default("unknown")
  warmupSignals                   Json               @default("{}")
  warmupThresholds                Json               @default("{}")
  warmupAssessedAt                DateTime?
  warmupHoldReason                String?
  warmupManualOverride            Boolean            @default(false)
  warmupOverrideReason            String?
  warmupOverrideUntil             DateTime?
  warmupOverrideConfirmedAt       DateTime?
  warmupOverrideConfirmedByUserId String?
  isConnected                     Boolean            @default(false)
  isDeleted                       Boolean            @default(false)
  createdAt                       DateTime           @default(now())
  updatedAt                       DateTime           @updatedAt

  // Relations
  tags                    Tag[]                    @relation("credential_tags")
  posts                   Post[]
  postAnalytics           PostAnalytics[]
  accountAnalyticsSnapshots AccountAnalyticsSnapshot[]
  postingCadences         PostingCadence[]
  slotReservations        SlotReservation[]
  adBulkUploadJobs        AdBulkUploadJob[]
  adPerformances          AdPerformance[]
  adWatchedAdvertisers    AdWatchedAdvertiser[]
  monitoredAccounts       MonitoredAccount[]
  socialSources           SocialSource[]
  socialConversations     SocialConversation[]
  socialMessages          SocialMessage[]
  personas                Persona[]                @relation("persona_credentials")
  outreachCampaigns       OutreachCampaign[]
  campaignPaidActivations CampaignPaidActivation[]
  socialWarmupEnrollments SocialWarmupEnrollment[]

  @@index([oauthTokenHash])
  @@index([organizationId, brandId, isDeleted, warmupState], map: "credentials_warmup_state_idx")
  @@index([brandId, platform, isDeleted, isConnected, createdAt], map: "credentials_brand_platform_connected_idx")
  // Account identity is (brandId, platform, externalId). The partial unique index
  // "credentials_brand_platform_external_key" and the pending-reap index live in
  // 20260825120000_credential_multi_account_identity — Prisma cannot express a
  // partial index, so they are SQL-only.
  @@map("credentials")
}

/// Pinned guided social-account warm-up enrollment. Distinct from admin
/// `WarmupAccount` (customer lead warmup). Active uniqueness is the partial
/// index `(organizationId, credentialId) WHERE isDeleted = false` in SQL.
model SocialWarmupEnrollment {
  id               String                      @id @default(cuid())
  organizationId   String
  organization     Organization                @relation(fields: [organizationId], references: [id])
  brandId          String
  brand            Brand                       @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  credentialId     String
  credential       Credential                  @relation(fields: [credentialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  blueprintId      String
  blueprintVersion Int
  startedAt        DateTime                    @default(now())
  currentPhaseId   String
  state            SocialWarmupEnrollmentState @default(ENROLLED)
  enrolledByUserId String
  enrolledByUser   User                        @relation(fields: [enrolledByUserId], references: [id])
  isDeleted        Boolean                     @default(false)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  events  SocialWarmupEvent[]
  signals SocialWarmupSignal[]

  @@unique([id, organizationId, brandId], map: "social_warmup_enrollments_id_scope_key")
  @@index([organizationId, brandId, credentialId, isDeleted], map: "social_warmup_enrollments_scope_credential_idx")
  @@index([organizationId, brandId, isDeleted, state], map: "social_warmup_enrollments_scope_state_idx")
  @@map("social_warmup_enrollments")
}

/// Append-only checklist audit. Provenance is the blueprint lowercase string
/// (`user_confirmed` / `platform_verified` / `genfeed_observed`).
model SocialWarmupEvent {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  brandId        String
  brand          Brand                   @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  enrollmentId   String
  enrollment     SocialWarmupEnrollment  @relation(fields: [enrollmentId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Cascade, onUpdate: Cascade)
  itemId         String
  provenance     String
  actorUserId    String
  actorUser      User                    @relation(fields: [actorUserId], references: [id])
  action         SocialWarmupEventAction
  occurredAt     DateTime                @default(now())
  isDeleted      Boolean                 @default(false)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId, brandId, enrollmentId, occurredAt], map: "social_warmup_events_scope_enrollment_idx")
  @@index([organizationId, enrollmentId, itemId, occurredAt], map: "social_warmup_events_item_idx")
  @@map("social_warmup_events")
}

/// Platform / Genfeed / user signal snapshot. Secrets never belong in evidence.
/// Active uniqueness is the partial index `(enrollmentId, key) WHERE isDeleted = false`.
model SocialWarmupSignal {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id])
  brandId        String
  brand          Brand                    @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  enrollmentId   String
  enrollment     SocialWarmupEnrollment   @relation(fields: [enrollmentId, organizationId, brandId], references: [id, organizationId, brandId], onDelete: Cascade, onUpdate: Cascade)
  key            String
  observedAt     DateTime?
  staleAt        DateTime?
  status         SocialWarmupSignalStatus
  source         SocialWarmupSignalSource
  evidence       Json                     @default("{}")
  isDeleted      Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([id, organizationId, brandId], map: "social_warmup_signals_id_scope_key")
  @@index([organizationId, brandId, enrollmentId, key, isDeleted], map: "social_warmup_signals_scope_key_idx")
  @@map("social_warmup_signals")
}

model ApiKey {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  key            String         @unique
  label          String
  category       ApiKeyCategory @default(GENFEEDAI)
  description    String?
  scopes         String[]       @default([])
  lastUsedAt     DateTime?
  lastUsedIp     String?
  expiresAt      DateTime?
  isRevoked      Boolean        @default(false)
  revokedAt      DateTime?
  usageCount     Int            @default(0)
  rateLimit      Int?
  allowedIps     String[]       @default([])
  keyFingerprint String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([keyFingerprint])
  @@map("api_keys")
}

model DesktopAuthCode {
  id             String    @id @default(cuid())
  codeHash       String    @unique
  codeChallenge  String
  stateHash      String
  userId         String
  organizationId String
  scopes         String[]  @default([])
  userEmail      String?
  userName       String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([expiresAt])
  @@index([userId, organizationId])
  @@map("desktop_auth_codes")
}

model AgentAuthRegistration {
  id                    String    @id @default(cuid())
  claimTokenHash        String    @unique
  claimAttemptTokenHash String    @unique
  userCodeHash          String
  emailHash             String
  requestedScopes       String[]  @default([])
  failedAttempts        Int       @default(0)
  userId                String?
  organizationId        String?
  expiresAt             DateTime
  claimedAt             DateTime?
  exchangedAt           DateTime?
  revokedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([expiresAt])
  @@index([emailHash, claimedAt])
  @@index([userId, organizationId])
  @@map("agent_auth_registrations")
}

model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientName              String?
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code"])
  responseTypes           String[] @default(["code"])
  tokenEndpointAuthMethod String   @default("none")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  authCodes McpOAuthAuthCode[]

  @@index([createdAt])
  @@map("oauth_clients")
}

model McpOAuthAuthCode {
  id                  String    @id @default(cuid())
  codeHash            String    @unique
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  stateHash           String
  clientId            String
  redirectUri         String
  resource            String
  scopes              String[]  @default([])
  userId              String
  organizationId      String
  userEmail           String?
  userName            String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  client OAuthClient @relation(fields: [clientId], references: [clientId])

  @@index([expiresAt])
  @@index([userId, organizationId])
  @@index([clientId])
  @@map("mcp_oauth_auth_codes")
}

model OrgIntegration {
  id               String              @id @default(cuid())
  organizationId   String
  organization     Organization        @relation(fields: [organizationId], references: [id])
  platform         IntegrationPlatform
  encryptedToken   String
  config           Json                @default("{}")
  status           IntegrationStatus   @default(ACTIVE)
  lastError        DateTime?
  lastErrorMessage String?
  isDeleted        Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([organizationId, isDeleted])
  @@map("org_integrations")
}

// ═══════════════════════════════════════════════════════════════
// CONTENT ASSETS — Ingredient is the core content entity
// ═══════════════════════════════════════════════════════════════

model Ingredient {
  id                  String             @id @default(cuid())
  userId              String?
  user                User?              @relation(fields: [userId], references: [id])
  organizationId      String?
  organization        Organization?      @relation(fields: [organizationId], references: [id])
  brandId             String?
  brand               Brand?             @relation("ingredient_brand", fields: [brandId], references: [id])
  folderId            String?
  folder              Folder?            @relation(fields: [folderId], references: [id])
  parentId            String?
  parent              Ingredient?        @relation("ingredient_parent", fields: [parentId], references: [id])
  children            Ingredient[]       @relation("ingredient_parent")
  metadataId          String?
  metadata            Metadata?          @relation(fields: [metadataId], references: [id])
  promptId            String?
  prompt              Prompt?            @relation("ingredient_prompt", fields: [promptId], references: [id])
  trainingId          String?
  training            Training?          @relation("ingredient_training", fields: [trainingId], references: [id])
  bookmarkId          String?
  bookmark            Bookmark?          @relation(fields: [bookmarkId], references: [id])
  personaId           String?
  persona             Persona?           @relation(fields: [personaId], references: [id])
  workflowExecutionId String?
  workflowExecution   WorkflowExecution? @relation(fields: [workflowExecutionId], references: [id], onDelete: SetNull)
  agentStrategyId     String?
  agentStrategy       AgentStrategy?     @relation("ingredient_agent_strategy", fields: [agentStrategyId], references: [id])
  sourceActionId      String?

  // Discriminator: single table for Image, Video, Music, GIF, Avatar, Voice, etc.
  category              IngredientCategory       @default(IMAGE)
  status                IngredientStatus         @default(DRAFT)
  transformations       TransformationCategory[] @default([])
  order                 Int                      @default(0)
  version               Int                      @default(1)
  isHighlighted         Boolean                  @default(false)
  isDefault             Boolean                  @default(false)
  scope                 AssetScope               @default(USER)
  isDeleted             Boolean                  @default(false)
  isFavorite            Boolean                  @default(false)
  isPublic              Boolean                  @default(false)
  groupId               String?
  groupIndex            Int?
  isMergeEnabled        Boolean?
  promptTemplate        String?
  templateVersion       Int?
  s3Key                 String?
  cdnUrl                String?
  personaSlug           String?
  contentRating         ContentRating?
  reviewStatus          FleetReviewStatus?
  assetLabel            FleetAssetLabel?
  generationSource      String?
  campaign              String?
  campaignWeek          Int?
  modelUsed             String?
  loraUsed              String?
  generationPrompt      String?
  negativePrompt        String?
  generationSeed        Int?
  cfgScale              Float?
  generationSteps       Int?
  workflowUsed          String?
  generationStage       String?
  generationProgress    Float?
  generationError       String?
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  fileSize              Int?
  mimeType              String?
  postedTo              String[]                 @default([])
  qualityScore          Float?
  qualityFeedback       String[]                 @default([])
  qualityStatus         QualityStatus            @default(UNRATED)

  // Voice discriminator fields (only populated when category = VOICE)
  voiceSource         String?
  voiceProvider       VoiceProvider?
  externalVoiceId     String?
  cloneStatus         VoiceCloneStatus?
  sampleAudioUrl      String?
  isCloned            Boolean?
  isVoiceActive       Boolean?
  isDefaultSelectable Boolean?
  providerData        Json?
  isFeatured          Boolean?

  // External voice catalog reference (set on generated/cloned voices that used a
  // provider catalog voice). Catalog entries themselves live in ExternalVoice,
  // NOT in ingredients — only generated/cloned voice ASSETS are ingredients.
  externalVoiceCatalogId String?
  externalVoiceCatalog   ExternalVoice? @relation("ingredient_external_voice", fields: [externalVoiceCatalogId], references: [id])

  // Video discriminator fields
  language String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-referential many-to-many (sources)
  sourceOf Ingredient[] @relation("ingredient_sources")
  sources  Ingredient[] @relation("ingredient_sources")

  // Relations where this ingredient is referenced
  tags                      Tag[]                      @relation("ingredient_tags")
  brandVoices               Brand[]                    @relation("brand_voice")
  brandMusics               Brand[]                    @relation("brand_music")
  postEntities              Post[]                     @relation("post_entity_ingredient")
  postIngredients           Post[]                     @relation("post_ingredients")
  postAnalyticsIngredients  PostAnalytics[]            @relation("post_analytics_ingredients")
  bookmarkExtracted         Bookmark[]                 @relation("bookmark_extracted")
  bookmarkGenerated         Bookmark[]                 @relation("bookmark_generated")
  trainingSources           Training[]                 @relation("training_sources")
  personaAvatars            Persona[]                  @relation("persona_avatar")
  personaVoices             Persona[]                  @relation("persona_voice")
  captions                  Caption[]
  editorProjectVideos       EditorProject[]            @relation("editor_project_video")
  trackedLinkContent        TrackedLink[]
  taskLinkedOutputs         Task[]                     @relation("task_linked_outputs")
  taskApprovedOutputs       Task[]                     @relation("task_approved_outputs")
  clipResults               ClipResult[]               @relation("clip_result_ingredient")
  workflowNodeContinuations WorkflowNodeContinuation[]

  @@index([groupId])
  @@index([scope])
  @@index([isPublic])
  @@index([workflowExecutionId])
  @@index([organizationId, sourceActionId], map: "ingredients_org_source_action_idx")
  @@index([agentStrategyId])
  @@index([personaSlug])
  @@index([isDeleted, personaId, reviewStatus])
  @@index([campaign, isDeleted, personaSlug])
  @@index([externalVoiceCatalogId])
  @@index([isDeleted, createdAt(sort: Desc)], map: "ingredients_deleted_created_at_idx")
  @@index([isDeleted, category, createdAt(sort: Desc)], map: "ingredients_deleted_category_created_at_idx")
  @@index([isDeleted, organizationId, createdAt(sort: Desc)], map: "ingredients_deleted_org_created_at_idx")
  @@index([organizationId, updatedAt, id], map: "ingredients_org_updated_at_id_idx")
  @@map("ingredients")
}

/// Provider voice catalog (ElevenLabs, HeyGen, …). Reference data synced from
/// provider APIs — NOT user-owned content, so no brand/org/isDeleted. Generated
/// or cloned voice ingredients reference an entry via Ingredient.externalVoiceCatalogId.
model ExternalVoice {
  id                  String        @id @default(cuid())
  externalId          String
  externalProvider    VoiceProvider
  name                String
  sampleAudioUrl      String?
  language            String?
  isActive            Boolean       @default(true)
  isDefaultSelectable Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  providerData        Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  ingredients Ingredient[] @relation("ingredient_external_voice")

  @@unique([externalProvider, externalId], map: "external_voices_provider_external_id_key")
  @@index([externalProvider, isActive, isDefaultSelectable], map: "external_voices_provider_active_selectable_idx")
  @@map("external_voices")
}

model Metadata {
  id               String            @id @default(cuid())
  label            String
  description      String            @default("Default Description")
  promptId         String?
  prompt           Prompt?           @relation(fields: [promptId], references: [id])
  model            String?
  style            String?
  extension        MetadataExtension
  assistant        String?
  result           String            @default("")
  error            String?
  externalId       String?
  externalProvider String?
  width            Int               @default(0)
  height           Int               @default(0)
  duration         Float             @default(0)
  size             Int               @default(0)
  hasAudio         Boolean           @default(false)
  fps              Float?
  resolution       String?
  seed             Int?
  promptTemplate   String?
  templateVersion  Int?
  isDeleted        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tags        Tag[]        @relation("metadata_tags")
  ingredients Ingredient[]

  @@index([externalId])
  @@index([externalProvider])
  @@map("metadata")
}

model Prompt {
  id                String          @id @default(cuid())
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id])
  brandId           String?
  brand             Brand?          @relation(fields: [brandId], references: [id])
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  ingredientId      String?
  articleId         String?
  article           Article?        @relation(fields: [articleId], references: [id])
  category          PromptCategory?
  original          String
  enhanced          String?
  status            PromptStatus    @default(DRAFT)
  style             String?
  mood              String?
  camera            String?
  scene             String?
  fontFamily        String?
  blacklists        String[]        @default([])
  sounds            String[]        @default([])
  model             String?
  duration          Float?
  ratio             String?
  resolution        String?
  seed              Int?
  reference         String?
  isSkipEnhancement Boolean         @default(false)
  scope             AssetScope      @default(USER)
  isDeleted         Boolean         @default(false)
  isFavorite        Boolean         @default(false)
  speech            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tags        Tag[]        @relation("prompt_tags")
  ingredients Ingredient[] @relation("ingredient_prompt")
  metadata    Metadata[]

  // Prompt list is scoped by owning user, not organization: the controller
  // filters `{ userId, scope, isDeleted }` and orders by `createdAt desc`
  // (prompts.controller findAll). No org-leading read path exists.
  @@index([userId, isDeleted, createdAt(sort: Desc)], map: "prompts_user_deleted_created_at_idx")
  @@map("prompts")
}

model Folder {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  parentId       String?
  parent         Folder?      @relation("folder_children", fields: [parentId], references: [id])
  label          String
  description    String?
  isActive       Boolean      @default(true)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tags        Tag[]        @relation("folder_tags")
  children    Folder[]     @relation("folder_children")
  ingredients Ingredient[]
  bookmarks   Bookmark[]

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([brandId, isDeleted, createdAt(sort: Desc)])
  @@index([parentId, isDeleted])
  @@map("folders")
}

model Tag {
  id              String        @id @default(cuid())
  userId          String?
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  brandId         String?
  brand           Brand?        @relation(fields: [brandId], references: [id])
  category        TagCategory?
  label           String
  description     String?
  key             String?
  backgroundColor String        @default("#000000")
  textColor       String        @default("#FFFFFF")
  isDeleted       Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Many-to-many relations
  ingredients Ingredient[] @relation("ingredient_tags")
  metadata    Metadata[]   @relation("metadata_tags")
  prompts     Prompt[]     @relation("prompt_tags")
  folders     Folder[]     @relation("folder_tags")
  credentials Credential[] @relation("credential_tags")
  posts       Post[]       @relation("post_tags")
  articles    Article[]    @relation("article_tags")
  personas    Persona[]    @relation("persona_tags")
  workflows   Workflow[]   @relation("workflow_tags")
  bookmarks   Bookmark[]   @relation("bookmark_tags")

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@index([brandId, isDeleted, createdAt(sort: Desc)])
  @@map("tags")
}

model Bookmark {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?           @relation(fields: [brandId], references: [id])
  folderId       String?
  folder         Folder?          @relation(fields: [folderId], references: [id])
  category       BookmarkCategory @default(URL)
  url            String
  platform       BookmarkPlatform @default(WEB)
  title          String?
  content        String
  description    String?
  author         String?
  authorHandle   String?
  thumbnailUrl   String?
  mediaUrls      String[]         @default([])
  platformData   Json             @default("{}")
  intent         BookmarkIntent   @default(INSPIRATION)
  savedAt        DateTime         @default(now())
  processedAt    DateTime?
  isDeleted      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tags                 Tag[]        @relation("bookmark_tags")
  extractedIngredients Ingredient[] @relation("bookmark_extracted")
  generatedIngredients Ingredient[] @relation("bookmark_generated")
  ingredients          Ingredient[]

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@map("bookmarks")
}

model Asset {
  id                 String                  @id @default(cuid())
  userId             String
  user               User                    @relation(fields: [userId], references: [id])
  parentType         AssetParent
  parentOrgId        String?
  parentBrandId      String?
  parentIngredientId String?
  parentArticleId    String?
  category           AssetCategory
  referenceCategory  ReferenceImageCategory?
  externalId         String?
  localAssetId       String?
  cloudObjectKey     String?
  sha256             String?
  sizeBytes          Int?
  mimeType           String?
  kind               String?
  origin             String?
  residency          String?
  uploadPolicy       String?
  originalFileName   String?
  displayName        String?
  isDeleted          Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // Live BRAND ranking/category lookup is supported by the raw-SQL partial
  // indexes assets_brand_kit_ranking_idx and
  // assets_brand_reference_category_idx; Prisma cannot represent their WHERE
  // predicates.
  @@index([parentOrgId, parentBrandId, updatedAt(sort: Desc)])
  @@index([parentOrgId, updatedAt, id], map: "assets_parent_org_updated_at_id_idx")
  @@index([sha256, sizeBytes])
  @@index([localAssetId])
  @@map("assets")
}

/// Immutable identity of the exact canonical-record state reviewed or used by
/// a consequential action. This references canonical records polymorphically;
/// it does not duplicate their content or lifecycle state.
model ContentVersionPin {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  brandId         String?
  brand           Brand?       @relation(fields: [brandId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  createdByUserId String
  createdByUser   User         @relation(fields: [createdByUserId], references: [id])
  recordKind      String
  recordId        String
  recordVersion   String?
  contentDigest   String
  idempotencyKey  String
  provenance      Json         @default("{}")
  createdAt       DateTime     @default(now())

  reviewedNewsletters Newsletter[]
  reviewedPosts       Post[]
  publishApprovals    PublishApproval[]

  @@unique([organizationId, idempotencyKey], map: "content_version_pins_org_idempotency_key")
  @@unique([id, organizationId], map: "content_version_pins_id_organization_key")
  @@index([organizationId, brandId, createdAt(sort: Desc)], map: "content_version_pins_org_brand_created_at_idx")
  @@index([organizationId, recordKind, recordId, createdAt(sort: Desc)], map: "content_version_pins_record_lookup_idx")
  @@map("content_version_pins")
}

model Link {
  id        String       @id @default(cuid())
  brandId   String
  brand     Brand        @relation(fields: [brandId], references: [id])
  label     String
  category  LinkCategory
  url       String
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("links")
}

model TrackedLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  brandId        String?
  brand          Brand?       @relation(fields: [brandId], references: [id])
  contentId      String?
  content        Ingredient?  @relation(fields: [contentId], references: [id])
  originalUrl    String
  shortUrl       String
  shortCode      String       @unique
  customSlug     String?
  contentType    String?
  platform       String?
  campaignName   String?
  title          String?
  utm            Json?
  stats          Json         @default("{\"totalClicks\":0,\"uniqueClicks\":0}")
  isActive       Boolean      @default(true)
  expiresAt      DateTime?
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  linkClicks               LinkClick[]
  subscriptionAttributions SubscriptionAttribution[] @relation("attribution_link")

  @@index([organizationId, isDeleted, createdAt(sort: Desc)])
  @@map("tracked_links")
}

model LinkClick {
  id         String      @id @default(cuid())
  linkId     String
  link       TrackedLink @relation(fields: [linkId], references: [id])
  timestamp  DateTime    @default(now())
  sessionId  String
  isUnique   Boolean     @default(false)
  referrer   String?
  userAgent  String?
  country    String?
  device     String?
  gaClientId String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([linkId, timestamp(sort: Desc)], map: "link_clicks_link_id_timestamp_idx")
  @@map("link_clicks")
}

// ═══════════════════════════════════════════════════════════════
// POSTS & SCHEDULING
// ═══════════════════════════════════════════════════════════════

model Post {
  id                  String             @id @default(cuid())
  // Polymorphic entity: either an Ingredient or an Article
  entityIngredientId  String?
  entityIngredient    Ingredient?        @relation("post_entity_ingredient", fields: [entityIngredientId], references: [id])
  entityArticleId     String?
  entityArticle       Article?           @relation("post_entity_article", fields: [entityArticleId], references: [id])
  entityModel         PostEntityModel?
