{
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.0",
    "prisma": "7.10.0"
  },
  "description": "Prisma schema, client, and migrations for Genfeed PostgreSQL",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./dist/src/client.d.ts",
      "default": "./src/client.ts"
    },
    "./testing": {
      "types": "./dist/src/testing.d.ts",
      "default": "./src/testing.ts"
    }
  },
  "name": "@genfeedai/prisma",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:model-metadata": "node scripts/generate-model-metadata.mjs && bunx biome check --write src/enum-field-map.ts && git diff --exit-code src/enum-field-map.ts",
    "db:generate": "prisma generate && node scripts/generate-model-metadata.mjs && bunx biome check --write src/enum-field-map.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "clean": "rm -rf dist",
    "postinstall": "bun run db:generate",
    "test": "vitest run",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit -p tsconfig.build.json"
  },
  "types": "./dist/src/index.d.ts",
  "version": "0.1.0"
}
