{
  "dependencies": {
    "@genfeedai/helpers": "workspace:*",
    "ts-jsonapi": "2.1.3",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Genfeed.ai canonical JSON:API serializers",
  "devDependencies": {
    "tsc-alias": "1.9.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "bun": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deserializer": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "AGPL-3.0",
  "main": "./dist/index.js",
  "name": "@genfeedai/serializers",
  "private": true,
  "repository": {
    "directory": "packages/serializers",
    "type": "git",
    "url": "git+https://github.com/genfeedai/genfeed.ai.git"
  },
  "scripts": {
    "build": "tsc --build && tsc-alias -p tsconfig.json && test -f dist/index.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "deps:update": "bunx npm-check-updates -u --reject typescript && bun install",
    "dev": "tsc --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "2.3.1"
}
