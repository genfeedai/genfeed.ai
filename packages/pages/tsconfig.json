{
  "compilerOptions": {
    "paths": {
      "@genfeedai/contracts/api-types/*": ["../contracts/src/api-types/*"],
      "@genfeedai/agent": ["../agent/src/index.ts"],
      "@genfeedai/agent/*": ["../agent/src/*"],
      "@genfeedai/client": ["../client/src/index.ts"],
      "@genfeedai/client/*": ["../client/src/*"],
      "@genfeedai/contracts/constants": ["../contracts/src/constants/index.ts"],
      "@genfeedai/contracts/constants/*": ["../contracts/src/constants/*"],
      "@genfeedai/contexts/*": ["../contexts/*"],
      "@genfeedai/contracts": ["../contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../contracts/src/*"],
      "@genfeedai/helpers": ["../helpers/src/index.ts"],
      "@genfeedai/helpers/*": ["../helpers/src/*"],
      "@genfeedai/hooks/*": ["../hooks/*"],
      "@genfeedai/contracts/interfaces": [
        "../contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": ["../contracts/src/interfaces/*"],
      "@genfeedai/models/*": ["../models/*"],
      "@genfeedai/props/*": ["../props/*"],
      "@genfeedai/providers/*": ["../contexts/providers/*"],
      "@genfeedai/serializers": ["../serializers/src/index.ts"],
      "@genfeedai/serializers/*": ["../serializers/src/*"],
      "@genfeedai/services/*": ["../services/*"],
      "@genfeedai/contracts/types": ["../contracts/src/types/index.ts"],
      "@genfeedai/contracts/types/*": ["../contracts/src/types/*"],
      "@genfeedai/ui/*": ["../ui/src/*", "../ui/src/components/*"],
      "@genfeedai/utils/*": ["../utils/*"],
      "@components/*": ["../ui/src/components/*"],
      "@configs/*": ["../next-config/*"],
      "@contexts/*": ["../contexts/*"],
      "@helpers/*": ["../helpers/src/*"],
      "@hooks/*": ["../hooks/*"],
      "@models/*": ["../models/*"],
      "@pages/*": ["../pages/*"],
      "@props/*": ["../props/*"],
      "@providers/*": ["../contexts/providers/*"],
      "@schemas/*": ["../schemas/*"],
      "@serializers/*": ["../serializers/src/*"],
      "@services/*": ["../services/*"],
      "@styles/*": ["../styles/*"],
      "@ui-constants/*": ["../ui/src/components/constants/*"],
      "@ui/*": ["../ui/src/*", "../ui/src/components/*"],
      "@utils/*": ["../utils/*"],
      "@app-tests/*": ["../../apps/app/tests/*"],
      "@genfeedai/config": ["../config/src/index.ts"],
      "@genfeedai/config/*": ["../config/src/*"],
      "@genfeedai/pricing": ["../pricing/src/index.ts"],
      "@genfeedai/ui": ["../ui/src/index.ts"],
      "@genfeedai/actions": ["../actions/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts"],
  "extends": "../tsconfig/base.json",
  "include": ["**/*.ts", "**/*.tsx"]
}
