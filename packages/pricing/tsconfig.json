{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true,
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@genfeedai/contracts": ["../contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../contracts/src/*"],
      "@genfeedai/contracts/interfaces": [
        "../contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": ["../contracts/src/interfaces/*"]
    },
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "include": ["src/**/*"],
  "references": [{ "path": "../contracts/tsconfig.json" }]
}
