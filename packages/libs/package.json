{
  "dependencies": {
    "@genfeedai/config": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/prisma": "workspace:*",
    "@genfeedai/storage": "workspace:*",
    "jose": "^6.2.10",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Shared backend library modules and infrastructure helpers for Genfeed server applications",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./*"
    }
  },
  "name": "@genfeedai/libs",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit -p tsconfig.json"
  },
  "sideEffects": false,
  "type": "module",
  "version": "0.1.0"
}
