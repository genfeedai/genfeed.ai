{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "paths": {
      "@libs/*": ["./*"]
    },
    "rootDir": ".",
    "sourceMap": true,
    "types": ["node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ],
  "extends": "../../tsconfig.server.decorators.json",
  "include": ["**/*.ts"]
}
