{
  "dependencies": {
    "@genfeedai/config": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/contexts": "workspace:*",
    "@genfeedai/models": "workspace:*",
    "@genfeedai/pricing": "workspace:*",
    "@genfeedai/props": "workspace:*",
    "@genfeedai/services": "workspace:*",
    "@genfeedai/ui": "workspace:*",
    "@genfeedai/utils": "workspace:*",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.57.0",
    "next-intl": "4.14.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "socket.io-client": "4.8.4",
    "zustand": "5.0.15",
    "@genfeedai/contracts": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@genfeedai/tsconfig": "workspace:*",
    "@tanstack/react-query": "5.104.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitest/browser": "5.0.4",
    "@vitest/browser-playwright": "5.0.4",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.4",
    "vitest-browser-react": "2.3.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "default": "./src/components/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*",
      "default": "./src/components/*"
    },
    "./constants/*": {
      "types": "./src/constants/*",
      "default": "./src/constants/*"
    },
    "./dashboard": {
      "types": "./src/dashboard/index.ts",
      "default": "./src/dashboard/index.ts"
    },
    "./dashboard/*": {
      "types": "./src/dashboard/*",
      "default": "./src/dashboard/*"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    },
    "./hooks/*": {
      "types": "./src/hooks/*",
      "default": "./src/hooks/*"
    },
    "./models": {
      "types": "./src/models/index.ts",
      "default": "./src/models/index.ts"
    },
    "./models/*": {
      "types": "./src/models/*",
      "default": "./src/models/*"
    },
    "./services/*": {
      "types": "./src/services/*",
      "default": "./src/services/*"
    },
    "./server": {
      "types": "./dist/server/server.d.ts",
      "default": "./src/server.ts"
    },
    "./stores": {
      "types": "./src/stores/index.ts",
      "default": "./src/stores/index.ts"
    },
    "./stores/*": {
      "types": "./src/stores/*",
      "default": "./src/stores/*"
    },
    "./utils/*": {
      "types": "./src/utils/*",
      "default": "./src/utils/*"
    },
    "./workflow": {
      "types": "./src/workflow/index.ts",
      "default": "./src/workflow/index.ts"
    },
    "./workflow/*": {
      "types": "./src/workflow/*",
      "default": "./src/workflow/*"
    }
  },
  "main": "src/index.ts",
  "name": "@genfeedai/agent",
  "private": true,
  "type": "module",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "vitest --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "sideEffects": false,
  "types": "src/index.ts",
  "version": "1.0.0"
}
