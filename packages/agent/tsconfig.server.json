{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist/server",
    "paths": {
      "@genfeedai/agent": ["./src/index.ts"],
      "@genfeedai/agent/*": ["./src/*"],
      "@genfeedai/contracts/interfaces": [
        "../contracts/dist/interfaces/index.d.ts"
      ],
      "@genfeedai/contracts/interfaces/*": ["../contracts/dist/interfaces/*"]
    },
    "rootDir": "./src"
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "dist", "node_modules"],
  "extends": "./tsconfig.json",
  "include": ["src/server.ts"]
}
