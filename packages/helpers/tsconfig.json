{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@genfeedai/contracts/constants": ["../contracts/src/constants/index.ts"],
      "@genfeedai/contracts/constants/*": ["../contracts/src/constants/*"],
      "@genfeedai/serializers": ["../serializers/src/index.ts"],
      "@genfeedai/serializers/*": ["../serializers/src/*"],
      "@genfeedai/contracts": ["../contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../contracts/src/*"],
      "@genfeedai/helpers/*": ["./src/*"],
      "@genfeedai/contracts/interfaces": [
        "../contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": ["../contracts/src/interfaces/*"],
      "@helpers/*": ["./src/*"],
      "@hooks/*": ["../hooks/*"],
      "@utils/*": ["../utils/*"]
    },
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022"
  },
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/voice-commands.helper.ts",
    "src/voice/**",
    "src/media/download/download.helper.ts"
  ],
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../contracts/tsconfig.json"
    }
  ]
}
