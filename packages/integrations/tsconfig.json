{
  "compilerOptions": {
    "declaration": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "paths": {
      "@genfeedai/contracts": ["../contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../contracts/src/*"],
      "@genfeedai/helpers": ["../helpers/src/index.ts"],
      "@genfeedai/helpers/*": ["../helpers/src/*"],
      "@genfeedai/integrations/*": ["./src/*"],
      "@genfeedai/contracts/interfaces": [
        "../contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": ["../contracts/src/interfaces/*"],
      "@integrations/*": ["./src/*"]
    },
    "rootDir": "src",
    "target": "es2022"
  },
  "exclude": ["dist", "node_modules", "**/*.spec.ts", "**/*.test.ts"],
  "extends": "../../tsconfig.json",
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../contracts/tsconfig.json"
    },
    {
      "path": "../helpers/tsconfig.json"
    }
  ]
}
