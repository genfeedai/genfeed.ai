{
  "dependencies": {
    "@genfeedai/pricing": "workspace:*",
    "dotenv": "17.4.2",
    "jose": "^6.2.10",
    "joi": "18.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "import": "./dist/deployment.js",
      "default": "./dist/deployment.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js",
      "default": "./dist/interfaces/index.js"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "import": "./dist/license.js",
      "default": "./dist/license.js"
    },
    "./license-server": {
      "types": "./dist/license-server.d.ts",
      "import": "./dist/license-server.js",
      "default": "./dist/license-server.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js",
      "default": "./dist/schemas/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "name": "@genfeedai/config",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "deployment": [
        "dist/deployment.d.ts"
      ],
      "interfaces": [
        "dist/interfaces/index.d.ts"
      ],
      "license": [
        "dist/license.d.ts"
      ],
      "license-server": [
        "dist/license-server.d.ts"
      ],
      "schemas": [
        "dist/schemas/index.d.ts"
      ]
    }
  },
  "version": "1.0.0"
}
