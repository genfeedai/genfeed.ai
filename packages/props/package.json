{
  "dependencies": {
    "@genfeedai/client": "workspace:*",
    "@genfeedai/contracts": "workspace:*",
    "@genfeedai/models": "workspace:*",
    "@genfeedai/serializers": "workspace:*",
    "@genfeedai/services": "workspace:*",
    "@remotion/player": "4.0.521",
    "@tiptap/core": "3.31.3"
  },
  "description": "Shared prop and view-model contracts for Genfeed UI surfaces",
