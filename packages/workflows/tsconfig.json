{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    // The video and media players live in `packages/ui/src/components` and are
    // not part of the published `@genfeedai/ui` package, so the workflow nodes
    // import them through the `@ui/*` alias. Type-check follows them into that
    // source and has to resolve its own imports. Node resolution cannot: the
    // `props`/`services` export maps are `"./*": "./*"`, and TypeScript reads
    // the `.props` / `.service` suffix as a file extension, strips it, and then
    // looks for `<name>.d.props.ts`. These aliases are the same ones
    // `packages/ui` and `apps/web` already declare for those packages.
    "paths": {
      "@genfeedai/props": ["../props/index.ts"],
      "@genfeedai/props/*": ["../props/*"],
      "@genfeedai/services": ["../services/index.ts"],
      "@genfeedai/services/*": ["../services/*"],
      "@genfeedai/workflows": ["./src/index.ts"],
      "@genfeedai/workflows/*": ["./src/*"],
      "@ui/*": ["../ui/src/*", "../ui/src/components/*"]
    },
    "resolveJsonModule": true,
    // Type-check follows the `@ui/*` and `@genfeedai/services` aliases into
    // sibling package sources, so the root has to cover `packages/`.
    "rootDir": "..",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    // Colocated specs are part of the type-checked surface, so the matcher and
    // global types they rely on belong here. `build:types` compiles from
    // `tsconfig.types.json`, which excludes every test file.
    "types": ["node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*"]
}
