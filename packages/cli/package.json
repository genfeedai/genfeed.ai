{
  "author": "Genfeed.ai",
  "bin": {
    "genfeed": "dist/index.js",
    "gf": "dist/index.js"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "chalk": "6.0.0",
    "commander": "15.0.0",
    "ofetch": "1.5.1",
    "ora": "9.4.1",
    "socket.io-client": "4.8.3",
    "zod": "4.4.3"
  },
  "description": "Unified CLI for Genfeed.ai - Generate, schedule, analyze, and publish AI content from your terminal",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@genfeedai/constants": "workspace:*",
    "@genfeedai/enums": "workspace:*",
    "@genfeedai/errors": "workspace:*",
    "@genfeedai/interfaces": "workspace:*",
    "@genfeedai/serializers": "workspace:*",
    "@genfeedai/tools": "workspace:*",
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/genfeedai/genfeed.ai/tree/master/packages/cli",
  "keywords": [
    "genfeed",
    "ai",
    "image-generation",
    "video-generation",
    "cli"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "name": "@genfeedai/cli",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "directory": "packages/cli",
    "type": "git",
    "url": "git+https://github.com/genfeedai/genfeed.ai.git"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "build:standalone": "bun build src/index.ts --compile --outfile gf",
    "deps:update": "bunx npm-check-updates -u --reject typescript,@types/node && bun install",
    "dev": "bun run src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.6.0"
}
