{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "outDir": "dist",
    "paths": {
      "@/*": ["./src/*"],
      "@genfeedai/actions": ["../actions/src/index.ts"],
      "@genfeedai/contracts": ["../contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../contracts/src/*"],
      "@genfeedai/contracts/constants": ["../contracts/src/constants/index.ts"],
      "@genfeedai/contracts/constants/*": ["../contracts/src/constants/*"],
      "@genfeedai/contracts/interfaces/*": ["../contracts/src/interfaces/*"],
      "@genfeedai/errors": ["../errors/src/index.ts"],
      "@genfeedai/helpers": ["../helpers/src/index.ts"],
      "@genfeedai/helpers/*": ["../helpers/src/*"],
      "@genfeedai/pricing": ["../pricing/src/index.ts"],
      "@genfeedai/serializers": ["../helpers/src/deserializer/index.ts"]
    },
    "resolveJsonModule": true,
    "rootDir": "..",
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node", "react"]
  },
  "exclude": ["node_modules", "dist", "tests"],
  "include": ["src/**/*"]
}
