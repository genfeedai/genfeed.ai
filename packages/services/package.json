{
  "dependencies": {
    "@genfeedai/client": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/contracts": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/serializers": "workspace:*",
    "zod": "4.6.5"
  },
  "description": "Shared client-facing services and orchestration helpers for Genfeed applications",
  "devDependencies": {
    "vitest": "5.0.1"
  },
  "exports": {
    "./*": "./*"
  },
  "name": "@genfeedai/services",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit"
  },
  "sideEffects": false,
  "version": "0.1.0"
}
