{
  "dependencies": {
    "@genfeedai/client": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/contracts": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/serializers": "workspace:*",
    "axios": "1.21.1",
    "lucide-react": "1.80.0",
    "pino": "10.4.0",
    "socket.io-client": "4.8.4",
    "sonner": "2.0.8",
    "zod": "4.6.7",
    "@sentry/browser": "11.17.0"
  },
  "description": "Shared client-facing services and orchestration helpers for Genfeed applications",
  "devDependencies": {
    "@genfeedai/tsconfig": "workspace:*",
    "vitest": "5.1.2"
  },
  "exports": {
    "./*": "./*"
  },
  "name": "@genfeedai/services",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && bun check --no-script"
  },
  "sideEffects": false,
  "version": "0.1.0"
}
