{
  "devDependencies": {
    "@sentry/nextjs": "11.9.0",
    "@types/node": "26.6.6",
    "next": "*",
    "tailwindcss": "*",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "exports": {
    ".": {
      "types": "./next.config.base.ts",
      "import": "./next.config.base.ts",
      "default": "./next.config.base.ts"
    },
    "./tailwind": {
      "types": "./tailwind.config.base.ts",
      "import": "./tailwind.config.base.ts",
      "default": "./tailwind.config.base.ts"
    }
  },
  "files": [
    "dist",
    "next.config.base.ts",
    "tailwind.config.base.ts"
  ],
  "main": "./next.config.base.ts",
  "name": "@genfeedai/next-config",
  "type": "module",
  "peerDependencies": {
    "@sentry/nextjs": "11.8.0",
    "next": "*"
  },
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "test": "vitest run --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit"
  },
  "types": "./next.config.base.ts",
  "version": "1.0.0"
}
