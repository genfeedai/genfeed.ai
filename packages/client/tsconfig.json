{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "inlineSources": true,
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "paths": {
      "@genfeedai/client": ["./src"],
      "@genfeedai/client/*": ["./src/*"],
      "@genfeedai/contracts/constants": ["../contracts/src/constants/index.ts"],
      "@genfeedai/contracts/constants/*": ["../contracts/src/constants/*"],
      "@genfeedai/contracts": ["../contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../contracts/src/*"],
      "@genfeedai/contracts/interfaces": [
        "../contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": ["../contracts/src/interfaces/*"],
      "@models/*": ["../models/*.d.ts"],
      "@props/*": ["../props/*.d.ts"],
      "@services/*": ["../services/*.d.ts"],
      "interfaces/*": ["./src/interfaces/*"],
      "models/*": ["./src/models/*"],
      "schemas/*": ["./src/schemas/*"]
    },
    "rootDir": "./src",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022"
  },
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "src/**/*.spec.ts"],
  "include": ["src/**/*"],
  "references": [
    {
      "path": "../contracts/tsconfig.json"
    }
  ]
}
