{
  "name": "@genfeedai/storage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./path-containment": {
      "types": "./dist/path-containment.d.ts",
      "import": "./dist/path-containment.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1125.0",
    "@aws-sdk/credential-provider-ini": "3.973.15",
    "@aws-sdk/lib-storage": "3.1125.0",
    "@genfeedai/config": "workspace:*"
  }
}
