{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "../..",
    "types": ["node", "vitest/globals"],
    "paths": {
      "@config/*": ["../config/src/*"],
      "@genfeedai/config": ["../config/src/index.ts"],
      "@genfeedai/config/*": ["../config/src/*"]
    }
  },
  "exclude": ["dist", "node_modules"],
  "extends": "./tsconfig.json",
  "include": ["src"]
}
