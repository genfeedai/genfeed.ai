{
  "dependencies": {
    "@genfeedai/enums": "workspace:*",
    "@genfeedai/interfaces": "workspace:*",
    "zod": "4.5.4"
  },
  "description": "Auto-generated TypeScript types from OpenAPI spec with Zod validation schemas",
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "tsc-alias": "1.9.2",
    "@typescript/native": "npm:typescript@7.0.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "main": "./dist/index.js",
  "name": "@genfeedai/api-types",
  "private": true,
  "repository": {
    "directory": "packages/api-types",
    "type": "git",
    "url": "git+https://github.com/genfeedai/genfeed.ai.git"
  },
  "scripts": {
    "build": "tsc --build && tsc-alias -p tsconfig.json --resolve-full-paths && bun run verify:compiled-contracts && mkdir -p dist/generated && cp src/generated/api.d.ts dist/generated/api.d.ts",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "generate": "bun run scripts/generate.ts --skip-on-error",
    "generate:strict": "bun run scripts/generate.ts",
    "prepublishOnly": "bun run build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit",
    "verify:compiled-contracts": "bun run scripts/verify-compiled-contracts.ts"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.0.1"
}
