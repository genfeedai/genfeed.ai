{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"],
      "@genfeedai/contracts/api-types/*": [
        "../../../../../packages/contracts/src/api-types/*"
      ],
      "@genfeedai/contracts/types/*": [
        "../../../packages/contracts/src/types/*"
      ],
      "@genfeedai/agent": ["../../../packages/agent/src/index.ts"],
      "@genfeedai/agent/*": ["../../../packages/agent/src/*"],
      "@genfeedai/contracts/interfaces": [
        "../../../packages/contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": [
        "../../../packages/contracts/src/interfaces/*"
      ],
      "@genfeedai/ui/*": ["../../../../packages/ui/src/*"],
      "@commands/*": ["./src/commands/*"],
      "@services/*": ["./src/services/*"],
      "@types/*": ["./src/types/*"],
      "@ui/*": ["../../../../packages/ui/src/*"],
      "@views/*": ["./src/views/*"]
    },
    "resolveJsonModule": true,
    // Widened to the repo root because `@genfeedai/ui/*` resolves to
    // `packages/ui/src`. Inert in practice: `tsc` only ever runs `--noEmit`
    // here, and `dist/extension.js` is produced by esbuild.
    "rootDir": "../../../..",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "target": "es2022",
    "types": ["bun-types", "node", "vscode"]
  },
  "exclude": ["node_modules", "dist", "src/webview/**/*"],
  "include": ["src/**/*"]
}
