{
  "author": "vincent@genfeed.ai",
  "dependencies": {
    "@genfeedai/auth-client": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/next-config": "workspace:*",
    "@genfeedai/ui": "workspace:*",
    "@genfeedai/utils": "workspace:*",
    "@plasmohq/storage": "1.15.0",
    "@sentry/browser": "10.73.0",
    "axios": "1.20.0",
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.15",
    "@genfeedai/contracts": "workspace:*",
    "@genfeedai/actions": "workspace:*",
    "@genfeedai/agent": "workspace:*"
  },
  "description": "Genfeed.ai - Generate (good) AI content for your business",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "autoprefixer": "10.6.1",
    "jsdom": "29.1.1",
    "postcss": "8.5.30",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "vitest": "5.0.4"
  },
  "displayName": "GenFeed",
  "exports": {
    "./background": "./src/background.ts",
    "./content": "./src/content.ts",
    "./popup": "./src/popup.tsx",
    "./sidepanel": "./src/sidepanel.tsx"
  },
  "manifest": {
    "host_permissions": [
      "https://*.genfeed.localhost/*",
      "http://genfeed.localhost/*",
      "https://app.genfeed.ai/*",
      "https://genfeed.ai/*",
      "https://*.twitter.com/*",
      "https://*.x.com/*",
      "https://*.youtube.com/*",
      "https://*.instagram.com/*",
      "https://*.reddit.com/*",
      "https://*.facebook.com/*",
      "https://*.tiktok.com/*",
      "https://*.linkedin.com/*",
      "https://api.genfeed.ai/*"
    ],
    "key": "",
    "permissions": [
      "cookies",
      "contextMenus",
      "downloads",
      "storage",
      "tabs",
      "scripting",
      "activeTab",
      "sidePanel",
      "nativeMessaging"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  },
  "name": "@genfeedai/extension-browser",
  "type": "module",
  "scripts": {
    "build": "bun run css:build && npm exec plasmo build",
    "cache:clear": "./scripts/bash/cache-clear.sh",
    "deps:update": "bunx npm-check-updates -u --reject typescript,tailwindcss,jsdom,@types/node && bun install",
    "css:build": "bun run ../../../../scripts/ui/build-extension-theme-css.ts",
    "css:watch": "bun run ../../../../scripts/ui/build-extension-theme-css.ts --watch",
    "dev": "bun run ../../../../scripts/ui/dev-browser-extension.ts",
    "dev:debug": "PLASMO_PUBLIC_ENV=development bun run dev",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "package": "bun run css:build && npm exec plasmo package",
    "prepare:deploy": "bun run format:fix && bun run build",
    "start:dev": "bun run dev",
    "test": "npx vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "version": "1.0.0",
  "alias": {
    "react": "./node_modules/react/index.js",
    "react/jsx-runtime": "./node_modules/react/jsx-runtime.js",
    "react/jsx-dev-runtime": "./node_modules/react/jsx-dev-runtime.js",
    "react-dom": "./node_modules/react-dom/index.js",
    "react-dom/client": "./node_modules/react-dom/client.js",
    "react-dom/server": "./node_modules/react-dom/server.js",
    "@genfeedai/helpers": "../../../../packages/helpers/src/index.ts",
    "@genfeedai/helpers/*": "../../../../packages/helpers/src/$1",
    "@genfeedai/contracts": "../../../../packages/contracts/src/index.ts",
    "@genfeedai/contracts/*": "../../../../packages/contracts/src/$1",
    "@genfeedai/auth-client/react": "../../../../packages/auth-client/src/react.tsx"
  }
}
