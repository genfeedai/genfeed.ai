{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@genfeedai/desktop-contracts": [
        "../../../packages/desktop-contracts/src/index.ts"
      ],
      "@genfeedai/desktop-core": [
        "../../../packages/desktop-core/src/index.ts"
      ],
      "@genfeedai/desktop-prisma": [
        "../../../packages/desktop-prisma/src/index.ts"
      ],
      "@genfeedai/helpers": ["../../../packages/helpers/src/index.ts"],
      "@genfeedai/helpers/*": ["../../../packages/helpers/src/*"],
      "@genfeedai/workflows": ["../../../packages/workflows/src/index.ts"],
      "@genfeedai/workflows/*": ["../../../packages/workflows/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"],
  "extends": "../../../tsconfig.json",
  "include": ["src/**/*.ts"]
}
