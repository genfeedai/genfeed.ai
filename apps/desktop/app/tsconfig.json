{
  "compilerOptions": {
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      // `@genfeedai/helpers` and `@genfeedai/workflows` are mapped to source
      // below, so their own workspace imports must be mapped too — otherwise
      // tsc type-checks their `src/` against unresolvable module specifiers and
      // every exported signature degrades to `any`.
      "@genfeedai/contracts/constants": [
        "../../../packages/contracts/src/constants/index.ts"
      ],
      "@genfeedai/contracts/constants/*": [
        "../../../packages/contracts/src/constants/*"
      ],
      "@genfeedai/contracts/desktop": [
        "../../../packages/contracts/src/desktop/index.ts"
      ],
      "@genfeedai/desktop-core": [
        "../../../packages/desktop-core/src/index.ts"
      ],
      "@genfeedai/desktop-prisma": [
        "../../../packages/desktop-prisma/src/index.ts"
      ],
      "@genfeedai/actions": ["../../../packages/actions/src/index.ts"],
      "@genfeedai/actions/*": ["../../../packages/actions/src/*"],
      "@genfeedai/contracts": ["../../../packages/contracts/src/index.ts"],
      "@genfeedai/contracts/*": ["../../../packages/contracts/src/*"],
      "@genfeedai/helpers": ["../../../packages/helpers/src/index.ts"],
      "@genfeedai/helpers/*": ["../../../packages/helpers/src/*"],
      "@genfeedai/contracts/interfaces": [
        "../../../packages/contracts/src/interfaces/index.ts"
      ],
      "@genfeedai/contracts/interfaces/*": [
        "../../../packages/contracts/src/interfaces/*"
      ],
      "@genfeedai/pricing": ["../../../packages/pricing/src/index.ts"],
      "@genfeedai/pricing/*": ["../../../packages/pricing/src/*"],
      "@genfeedai/workflows": ["../../../packages/workflows/src/index.ts"],
      "@genfeedai/workflows/*": ["../../../packages/workflows/src/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "exclude": ["dist", "node_modules", "src/**/*.test.ts"],
  "extends": "../../../tsconfig.json",
  "include": ["src/**/*.ts"]
}
