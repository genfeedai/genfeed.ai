{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "type-check": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/fonts/**",
        "$TURBO_ROOT$/packages/pages/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/**/node_modules/**"
      ]
    },
    "build": {
      "dependsOn": [
        "//#env:check",
        "@genfeedai/auth-client#build",
        "@genfeedai/config#build",
        "@genfeedai/integrations#build",
        "@genfeedai/pricing#build",
        "@genfeedai/serializers#build"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "BUILD_ID",
        "VERCEL_GIT_COMMIT_SHA",
        "RELEASE_TAG"
      ],
      // Turbo's strict env mode drops undeclared variables, so without these the
      // Sentry build plugin never saw its token and no source maps were uploaded.
      // Pass-through keeps the secret out of the task hash.
      "passThroughEnv": [
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_RELEASE"
      ],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/contexts/**",
        "$TURBO_ROOT$/packages/fonts/**",
        "$TURBO_ROOT$/packages/hooks/**",
        "$TURBO_ROOT$/packages/models/**",
        "$TURBO_ROOT$/packages/pages/**",
        "$TURBO_ROOT$/packages/props/**",
        "$TURBO_ROOT$/packages/serializers/**",
        "$TURBO_ROOT$/packages/services/**",
        "$TURBO_ROOT$/packages/ui/**",
        "$TURBO_ROOT$/packages/utils/**",
        "!$TURBO_ROOT$/packages/ui/.turbo/**",
        "!$TURBO_ROOT$/packages/ui/dist/**",
        "!$TURBO_ROOT$/packages/ui/node_modules/**",
        "!$TURBO_ROOT$/packages/ui/**/*.tsbuildinfo"
      ]
    }
  }
}
