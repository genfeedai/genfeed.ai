{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // tsconfig `paths` reach these workspaces' sources without a declared
    // dependency, so `^build` never hashes them. Explicit globs ignore
    // .gitignore, hence the exclusions.
    "type-check": {
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/packages/fonts/**",
        "$TURBO_ROOT$/packages/pages/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/**/node_modules/**"
      ]
    },
    "build": {
      "dependsOn": [
        "//#env:check",
        "@genfeedai/auth-client#build",
        "@genfeedai/config#build",
        "@genfeedai/integrations#build",
        "@genfeedai/pricing#build"
      ],
      "env": [
        "$TURBO_EXTENDS$",
        "BUILD_ID",
        "VERCEL_GIT_COMMIT_SHA",
        "RELEASE_TAG"
      ],
      "inputs": [
        "$TURBO_EXTENDS$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/contexts/**",
        "$TURBO_ROOT$/packages/fonts/**",
        "$TURBO_ROOT$/packages/hooks/**",
        "$TURBO_ROOT$/packages/models/**",
        "$TURBO_ROOT$/packages/pages/**",
        "$TURBO_ROOT$/packages/props/**",
        "$TURBO_ROOT$/packages/serializers/**",
        "$TURBO_ROOT$/packages/services/**",
        "$TURBO_ROOT$/packages/utils/**"
      ]
    }
  }
}
