# Generated output reference for `apps/app`.
# Canonical source of truth: `../../.env.local|.env.staging|.env.production`
# Regenerate with `bun run env:sync <local|staging|production>`.
# Do not maintain secrets here manually.

# Local development endpoints
NEXT_PUBLIC_API_ENDPOINT=https://app.genfeed.localhost/v1
NEXT_PUBLIC_MCP_ENDPOINT=https://mcp.genfeed.localhost/mcp
NEXT_PUBLIC_WS_ENDPOINT=https://notifications.genfeed.localhost
NEXT_PUBLIC_APPS_APP_ENDPOINT=https://app.genfeed.localhost

# Better Auth
NEXT_PUBLIC_BETTER_AUTH_ENABLED=true
NEXT_PUBLIC_BETTER_AUTH_SIGN_IN_URL=/login
NEXT_PUBLIC_BETTER_AUTH_SIGN_UP_URL=/sign-up

# Better Auth - Redirect configuration
NEXT_PUBLIC_BETTER_AUTH_SIGN_IN_FORCE_REDIRECT_URL=/
NEXT_PUBLIC_BETTER_AUTH_SIGN_UP_FORCE_REDIRECT_URL=/onboarding/post-signup
NEXT_PUBLIC_BETTER_AUTH_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_BETTER_AUTH_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/post-signup
BETTER_AUTH_SIGN_UP_FORCE_REDIRECT_URL=/onboarding/post-signup

# Sentry
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# OAuth
MEDIUM_REDIRECT_URI=https://app.genfeed.localhost/auth/medium/callback

# CDN
NEXT_PUBLIC_CDN_URL=https://staging-cdn.genfeed.ai
