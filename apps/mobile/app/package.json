  "main": "expo-router/entry",
  "name": "@genfeedai/mobile",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "expo start --android",
    "cache:clear": "rm -rf node_modules .expo .expo-shared .next dist build",
    "deps:update": "bunx npm-check-updates -u --reject typescript,jsdom && bun install",
    "ios": "expo start --ios",
    "lint": "bunx expo lint",
    "lint:fix": "bunx expo lint --fix",
    "prepare:deploy": "bun run lint:fix && bun run type-check",
    "start": "expo start",
    "start:dev": "expo start --web",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "bun run ../../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit"
  },
  "version": "1.0.0"
}
