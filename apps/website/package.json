{
  "dependencies": {
    "@genfeedai/auth-client": "*",
    "@genfeedai/config": "*",
    "@genfeedai/helpers": "*",
    "@genfeedai/next-config": "*",
    "@genfeedai/pricing": "*",
    "@genfeedai/styles": "*",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-image": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-placeholder": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "clsx": "2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "posthog-js": "1.422.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Genfeed Website - Marketing site with landing pages, documentation, and public-facing content",
  "name": "@genfeedai/website",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "ANALYZE=true next build",
    "analyze:browser": "ANALYZE=true BUNDLE_ANALYZE=browser next build",
    "analyze:server": "ANALYZE=true BUNDLE_ANALYZE=server next build",
    "build": "next build --turbopack",
    "check:orphans": "bun run scripts/check-orphans.ts",
    "check:seo": "bun run scripts/check-seo.ts",
    "deps:update": "bunx npm-check-updates -u --reject typescript,@types/node && bun install",
    "dev": "bun run ../../scripts/dev/run-portless.ts website -- bun run dev:process",
    "generate:llms": "bun run scripts/generate-llms-txt.ts",
    "lint": "biome check app src packages scripts instrumentation.ts instrumentation-client.ts next.config.ts postcss.config.mjs tailwind.config.ts package.json tsconfig.json vercel.json sentry.edge.config.ts sentry.server.config.ts README.md",
    "prebuild": "bun run scripts/generate-llms-txt.ts",
    "start": "next start",
    "test": "vitest run --config ../vitest.config.mts",
    "test:cov": "vitest run --coverage --config ../vitest.config.mts",
    "test:watch": "vitest --config ../vitest.config.mts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit",
    "dev:process": "NODE_OPTIONS='--max-old-space-size=4096 --disable-warning=DEP0169' bun run ../../scripts/dev/run-service.ts website -- next dev --turbopack",
    "dev:debug": "bun run dev:process"
  },
  "version": "1.0.0",
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3"
  }
}
