{
  "dependencies": {
    "@genfeedai/libs": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/storage": "workspace:*",
    "@genfeedai/utils": "workspace:*",
    "@remotion/bundler": "4.0.520",
    "@remotion/renderer": "4.0.520",
    "bullmq": "6.3.4",
    "multer": "2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.520",
    "tsconfig-paths": "4.2.0",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Genfeed Files Service",
  "devDependencies": {
    "@types/ffprobe-static": "2.0.3",
    "@types/multer": "2.2.0"
  },
  "main": "../dist/apps/files/main.js",
  "name": "@genfeedai/files",
  "private": true,
  "scripts": {
    "build": "cd .. && nest build files",
    "build:prod": "cd .. && nest build files && cd files && (bun run sentry:sourcemaps || true)",
    "deps:update": "bunx npm-check-updates -u --reject typescript && bun install",
    "dev": "bun run ../../../scripts/dev/run-portless.ts files -- bun run dev:process",
    "dev:webpack": "cd .. && NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" nest start files --watch",
    "lint": "biome lint --write src --no-errors-on-unmatched",
    "sentry:inject": "sentry-cli sourcemaps inject --org genfeedai --project files-genfeed-ai ../dist/apps/files",
    "sentry:sourcemaps": "[ -z \"$SENTRY_AUTH_TOKEN\" ] && echo 'Sentry upload skipped (no token)' || (bun run sentry:inject && bun run sentry:upload)",
    "sentry:upload": "sentry-cli sourcemaps upload --org genfeedai --project files-genfeed-ai ../dist/apps/files",
    "start": "cd .. && nest start files",
    "start:debug": "cd .. && nest start files --debug --watch",
    "start:dev": "cd .. && NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" nest start files --watch",
    "start:prod": "node -r tsconfig-paths/register --max-old-space-size=8192 --expose-gc ../dist/apps/files/main",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit -p tsconfig.typecheck.json",
    "dev:process": "NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" bun run ../../../scripts/dev/run-service.ts files -- bun run ../../../scripts/dev/nest-fast-dev.ts files",
    "dev:debug": "bun run dev:process"
  },
  "version": "1.0.0",
  "type": "module"
}
