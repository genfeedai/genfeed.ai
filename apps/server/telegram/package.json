{
  "dependencies": {
    "@genfeedai/libs": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/integrations": "workspace:*",
    "grammy": "1.46.0",
    "tsconfig-paths": "4.2.0",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Genfeed Telegram Service",
  "devDependencies": {
    "unplugin-swc": "1.5.11"
  },
  "main": "../dist/apps/telegram/main.js",
  "name": "@genfeedai/telegram",
  "private": true,
  "scripts": {
    "build": "cd .. && nest build telegram",
    "build:prod": "cd .. && nest build telegram && cd telegram && if [ -n \"$SENTRY_AUTH_TOKEN\" ]; then bun run sentry:sourcemaps || true; fi",
    "deps:update": "bunx npm-check-updates -u --reject typescript && bun install",
    "dev": "cd .. && NODE_OPTIONS=\"--max-old-space-size=2048 --expose-gc\" nest start telegram --watch",
    "lint": "biome lint --write src --no-errors-on-unmatched",
    "sentry:inject": "sentry-cli sourcemaps inject --org genfeedai --project telegram-genfeed-ai ../dist/apps/telegram",
    "sentry:sourcemaps": "[ -z \"$SENTRY_AUTH_TOKEN\" ] && echo 'Sentry upload skipped (no token)' || (bun run sentry:inject && bun run sentry:upload)",
    "sentry:upload": "sentry-cli sourcemaps upload --org genfeedai --project telegram-genfeed-ai ../dist/apps/telegram",
    "start": "cd .. && nest start telegram",
    "start:debug": "cd .. && nest start telegram --debug --watch",
    "start:dev": "cd .. && NODE_OPTIONS=\"--max-old-space-size=2048 --expose-gc\" nest start telegram --watch",
    "start:prod": "node -r tsconfig-paths/register --max-old-space-size=8192 --expose-gc ../dist/apps/telegram/main",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit -p tsconfig.typecheck.json"
  },
  "version": "1.0.0",
  "type": "module"
}
