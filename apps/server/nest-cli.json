{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "compilerOptions": {
    "builder": "swc",
    "deleteOutDir": false,
    "typeCheck": false
  },
  "monorepo": true,
  "projects": {
    "api": {
      "compilerOptions": {
        "assets": [
          {
            "exclude": "**/tsconfig*.json",
            "include": "config/**/*.json",
            "outDir": "dist/server/api/src",
            "watchAssets": true
          }
        ],
        "builder": {
          "options": {
            "configPath": "api/webpack.config.cjs"
          },
          "type": "webpack"
        },
        "tsConfigPath": "api/tsconfig.app.json"
      },
      "entryFile": "main",
      "root": "api",
      "sourceRoot": "api/src",
      "type": "application"
    },
    "api-articles-seed": {
      "compilerOptions": {
        "builder": {
          "options": {
            "configPath": "api/articles-seed.webpack.config.cjs"
          },
          "type": "webpack"
        },
        "tsConfigPath": "api/tsconfig.app.json"
      },
      "entryFile": "seeds/articles-seed.entrypoint",
      "root": "api",
      "sourceRoot": "api/src",
      "type": "application"
    },
    "api-credential-backfill": {
      "compilerOptions": {
        "builder": {
