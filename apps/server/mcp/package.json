{
  "dependencies": {
    "@genfeedai/libs": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/actions": "workspace:*",
    "@genfeedai/ui": "workspace:*",
    "@posthog/mcp": "0.12.0",
    "posthog-node": "5.51.6",
    "tsconfig-paths": "4.2.0",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Genfeed MCP Server",
  "main": "../dist/apps/mcp/main.js",
  "name": "@genfeedai/mcp",
  "scripts": {
    "build": "cd .. && nest build mcp",
    "build:prod": "cd .. && nest build mcp && cd mcp && (bun run sentry:sourcemaps || true)",
    "deps:update": "bunx npm-check-updates -u --reject typescript && bun install",
    "dev": "bun run ../../../scripts/dev/run-portless.ts mcp -- bun run dev:process",
    "dev:webpack": "cd .. && NODE_OPTIONS=\"--max-old-space-size=2048 --expose-gc\" nest start mcp --watch",
    "lint": "biome lint --write src --no-errors-on-unmatched",
    "sentry:inject": "sentry-cli sourcemaps inject --org genfeedai --project mcp-genfeed-ai ../dist/apps/mcp",
    "sentry:sourcemaps": "[ -z \"$SENTRY_AUTH_TOKEN\" ] && echo 'Sentry upload skipped (no token)' || (bun run sentry:inject && bun run sentry:upload)",
    "sentry:upload": "sentry-cli sourcemaps upload --org genfeedai --project mcp-genfeed-ai ../dist/apps/mcp",
    "start": "cd .. && nest start mcp",
    "start:debug": "cd .. && nest start mcp --debug --watch",
    "start:dev": "cd .. && NODE_OPTIONS=\"--max-old-space-size=2048 --expose-gc\" nest start mcp --watch",
    "start:prod": "node -r tsconfig-paths/register --max-old-space-size=8192 --expose-gc ../dist/apps/mcp/main",
    "test": "vitest run --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "type-check": "bun run ../../../scripts/architecture/check-typecheck-prerequisites.ts && tsc --noEmit -p tsconfig.typecheck.json",
    "dev:process": "NODE_OPTIONS=\"--max-old-space-size=2048 --expose-gc\" bun run ../../../scripts/dev/run-service.ts mcp -- bash -lc 'cd .. && nest start mcp --watch'",
    "dev:debug": "bun run dev:process"
  },
  "type": "module",
  "version": "1.0.0"
}
