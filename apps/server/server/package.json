{
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@aws-sdk/client-ec2": "3.1121.0",
    "@genfeedai/agent": "workspace:*",
    "@genfeedai/api-types": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/constants": "workspace:*",
    "@genfeedai/enums": "workspace:*",
    "@genfeedai/harness": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/integrations": "workspace:*",
    "@genfeedai/interfaces": "workspace:*",
    "@genfeedai/libs": "workspace:*",
    "@genfeedai/pricing": "workspace:*",
    "@genfeedai/prisma": "workspace:*",
    "@genfeedai/queue-contracts": "workspace:*",
    "@genfeedai/serializers": "workspace:*",
    "@genfeedai/actions": "workspace:*",
    "@genfeedai/types": "workspace:*",
    "@genfeedai/utils": "workspace:*",
    "@genfeedai/workflows": "workspace:*",
    "@nestjs/axios": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/event-emitter": "12.0.0",
    "axios": "1.20.0",
    "bullmq": "6.3.2",
    "effect": "3.22.1",
    "google-auth-library": "11.0.2",
    "googleapis": "176.0.0",
    "htmlparser2": "12.0.0",
    "jsonwebtoken": "9.0.3",
    "linkedin-api-client": "0.3.0",
    "openai": "7.8.0",
    "rxjs": "7.8.2",
    "twitter-api-v2": "1.29.1",
    "twitter-text": "3.1.0"
  },
  "description": "Server-tier services shared by Genfeed API and workers",
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.3",
    "@types/twitter-text": "3.1.10",
    "@typescript/native": "npm:typescript@7.0.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./src/index.ts",
  "name": "@genfeedai/server",
  "private": true,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.declarations.json",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.ts",
    "type-check": "bun run ../../../scripts/architecture/check-typecheck-prerequisites.ts --require-turbo && tsc --noEmit -p tsconfig.typecheck.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "0.1.0"
}
