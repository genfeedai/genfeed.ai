{
  "openapi": "3.0.4",
  "paths": {
    "/fal-ai/modern-video/image-to-video": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModernImageToVideoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModernVideoOutput"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ModernImageToVideoInput": {
        "type": "object",
        "required": ["prompt", "image_url"],
        "properties": {
          "prompt": { "type": "string" },
          "image_url": { "type": "string", "format": "uri" },
          "duration": { "type": "string", "enum": ["5", "10"] },
          "resolution": { "type": "string", "enum": ["720p", "1080p"] }
        }
      },
      "ModernVideoOutput": {
        "type": "object",
        "required": ["video"],
        "properties": {
          "video": {
            "type": "object",
            "required": ["url"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "content_type": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
