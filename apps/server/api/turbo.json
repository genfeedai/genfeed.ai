{
  "$schema": "https://v2-9-12.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "type-check": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/tsconfig.typecheck.base.json",
        "$TURBO_ROOT$/apps/server/files/src/**"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/**/src/**",
        "$TURBO_ROOT$/apps/server/**/scripts/**",
        "$TURBO_ROOT$/apps/server/**/*.json",
        "$TURBO_ROOT$/apps/server/**/*.cjs",
        "!$TURBO_ROOT$/apps/server/dist/**",
        "!$TURBO_ROOT$/apps/server/**/node_modules/**",
        "$TURBO_ROOT$/webpack.base.config.js",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/tsconfig.server.decorators.json",
        "$TURBO_ROOT$/configs/**"
      ],
      "outputs": [
        "$TURBO_ROOT$/apps/server/dist/apps/api/**",
        "$TURBO_ROOT$/apps/server/dist/apps/api-credential-backfill/**",
        "$TURBO_ROOT$/apps/server/dist/apps/api-articles-seed/**",
        "$TURBO_ROOT$/apps/server/dist/server/api/**"
      ]
    }
  }
}
