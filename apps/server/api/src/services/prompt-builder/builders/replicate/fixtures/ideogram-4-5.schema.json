    "/predictions": {
      "post": {
        "summary": "Predict",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "PredictionResponse",
                  "properties": {
                    "id": {
                      "type": "string",
                      "title": "Id"
                    },
                    "logs": {
                      "type": "string",
                      "title": "Logs"
                    },
                    "error": {
                      "type": "string",
                      "title": "Error"
                    },
                    "input": {
                      "type": "object",
                      "title": "Input",
                      "required": ["prompt"],
                      "properties": {
                        "mask": {
                          "type": "string",
                          "title": "Mask",
                          "format": "uri",
                          "x-order": 2,
                          "nullable": true,
                          "description": "Optional black and white mask for editing. Black pixels are edited, white pixels are preserved. Only used when at least one source image is provided. When a mask is used, the output matches the source size and the size input is ignored."
                        },
                        "seed": {
                          "type": "integer",
                          "title": "Seed",
                          "maximum": 2147483647,
                          "x-order": 6,
                          "nullable": true,
                          "description": "Random seed. Set for reproducible generation."
                        },
                        "size": {
                          "enum": [
                            "source",
                            "1024x1024",
                            "1280x896",
                            "896x1280",
                            "1344x768",
                            "768x1344",
                            "1536x640",
                            "640x1536"
                          ],
                          "type": "string",
                          "title": "size",
                          "description": "Output size. 'source' preserves the source image proportions. Ignored when a mask is provided.",
                          "default": "source",
                          "x-order": 3
                        },
                        "images": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "format": "uri"
                          },
                          "title": "Images",
                          "x-order": 1,
                          "nullable": true,
                          "description": "Up to 5 source images to edit. Omit for text-to-image generation. When a mask is provided, the first image is edited and the rest are used as references."
                        },
                        "prompt": {
                          "type": "string",
                          "title": "Prompt",
                          "x-order": 0,
                          "description": "Text prompt. Describe the image to generate, or the edit to apply to the source images."
                        },
                        "quality": {
                          "enum": ["very_low", "low", "medium", "high"],
                          "type": "string",
                          "title": "quality",
                          "description": "Edit quality. Higher quality is slower and more expensive.",
                          "default": "medium",
                          "x-order": 4
                        },
                        "num_images": {
                          "type": "integer",
                          "title": "Num Images",
                          "default": 1,
                          "maximum": 8,
                          "minimum": 1,
                          "x-order": 5,
                          "description": "Number of images to generate."
                        }
                      }
                    },
                    "output": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      },
                      "title": "Output"
                    },
                    "status": {
                      "type": "string",
                      "title": "Status"
                    },
                    "metrics": {
                      "type": "object",
                      "title": "Metrics"
                    },
                    "version": {
                      "type": "string",
                      "title": "Version"
                    },
                    "created_at": {
                      "type": "string",
                      "title": "Created At",
                      "format": "date-time"
                    },
                    "started_at": {
                      "type": "string",
                      "title": "Started At",
                      "format": "date-time"
                    },
                    "completed_at": {
                      "type": "string",
                      "title": "Completed At",
                      "format": "date-time"
                    }
                  }
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
