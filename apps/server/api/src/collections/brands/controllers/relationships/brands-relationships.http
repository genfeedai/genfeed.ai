### Genfeed API - Brands Relationships Endpoints
### Brand musics (no flat dual yet) and brand analytics aggregates
### Prefer flat collections for media lists:
###   GET /videos?brand=  /images?brand=  /articles?brand=
###   GET /credentials?brand=  /links?brand=  /posts?brand=  /activities?brand=
### Protected by RolesGuard

########################################
# Brand Musics
########################################

### Get Brand Musics
GET {{apiBaseUrl}}/brands/{{testBrandId}}/musics
Authorization: Bearer {{bearerToken}}


### Get Brand Musics with Pagination
GET {{apiBaseUrl}}/brands/{{testBrandId}}/musics?page=1&limit=20
Authorization: Bearer {{bearerToken}}


########################################
# Brand Analytics
########################################

### Get Brand Analytics
GET {{apiBaseUrl}}/brands/{{testBrandId}}/analytics
Authorization: Bearer {{bearerToken}}


### Get Brand Analytics with Date Range
GET {{apiBaseUrl}}/brands/{{testBrandId}}/analytics?startDate=2026-01-01&endDate=2026-02-15
Authorization: Bearer {{bearerToken}}


### Get Brand Platform-Specific Analytics
GET {{apiBaseUrl}}/brands/{{testBrandId}}/platforms/twitter/analytics
Authorization: Bearer {{bearerToken}}


### Get Brand Platform Analytics with Date Range
GET {{apiBaseUrl}}/brands/{{testBrandId}}/platforms/instagram/analytics?startDate=2026-01-01&endDate=2026-02-15
Authorization: Bearer {{bearerToken}}


### Get Brand Analytics Time Series
GET {{apiBaseUrl}}/brands/{{testBrandId}}/analytics/timeseries
Authorization: Bearer {{bearerToken}}


### Get Brand Analytics Time Series with Filters
GET {{apiBaseUrl}}/brands/{{testBrandId}}/analytics/timeseries?startDate=2026-01-01&endDate=2026-02-15&groupBy=day
Authorization: Bearer {{bearerToken}}


########################################
# Flat collection equivalents (preferred)
########################################

### List Brand Videos (flat)
GET {{apiBaseUrl}}/videos?brand={{testBrandId}}&page=1&limit=20&sort=-createdAt
Authorization: Bearer {{bearerToken}}


### List Brand Images (flat)
GET {{apiBaseUrl}}/images?brand={{testBrandId}}&page=1&limit=20&sort=-createdAt
Authorization: Bearer {{bearerToken}}


### List Brand Articles (flat)
GET {{apiBaseUrl}}/articles?brand={{testBrandId}}&page=1&limit=20&sort=-publishedAt
Authorization: Bearer {{bearerToken}}


### List Brand Credentials (flat)
GET {{apiBaseUrl}}/credentials?brand={{testBrandId}}
Authorization: Bearer {{bearerToken}}


### List Brand Links (flat)
GET {{apiBaseUrl}}/links?brand={{testBrandId}}&page=1&limit=50
Authorization: Bearer {{bearerToken}}


### List Brand Posts (flat)
GET {{apiBaseUrl}}/posts?brand={{testBrandId}}&platform=twitter&status=scheduled&page=1&limit=20&sort=-scheduledDate
Authorization: Bearer {{bearerToken}}


### List Brand Activities (flat)
GET {{apiBaseUrl}}/activities?brand={{testBrandId}}&page=1&limit=20&sort=-createdAt
Authorization: Bearer {{bearerToken}}


########################################
# Test Cases
########################################

### Test: Invalid Brand ID (analytics)
GET {{apiBaseUrl}}/brands/invalid-id/analytics
Authorization: Bearer {{bearerToken}}


### Test: Brand Not Found (analytics)
GET {{apiBaseUrl}}/brands/507f1f77bcf86cd799439011/analytics
Authorization: Bearer {{bearerToken}}


### Test: Unauthorized Access (analytics)
GET {{apiBaseUrl}}/brands/{{testBrandId}}/analytics
