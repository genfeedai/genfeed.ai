{
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@aws-sdk/client-cloudfront": "3.1125.0",
    "@aws-sdk/client-ec2": "3.1125.0",
    "@better-auth/infra": "0.4.5",
    "@genfeedai/actions": "workspace:*",
    "@genfeedai/agent": "workspace:*",
    "@genfeedai/auth-client": "workspace:*",
    "@genfeedai/config": "workspace:*",
    "@genfeedai/harness": "workspace:*",
    "@genfeedai/helpers": "workspace:*",
    "@genfeedai/integrations": "workspace:*",
    "@genfeedai/libs": "workspace:*",
    "@genfeedai/pricing": "workspace:*",
    "@genfeedai/prisma": "workspace:*",
    "@genfeedai/serializers": "workspace:*",
    "@genfeedai/utils": "workspace:*",
    "@genfeedai/workflows": "workspace:*",
    "@nestjs/axios": "12.0.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/event-emitter": "12.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "archiver": "8.0.0",
    "axios": "1.20.0",
    "bcrypt": "6.0.0",
    "better-auth": "1.6.29",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "google-auth-library": "11.0.2",
    "googleapis": "178.0.0",
    "htmlparser2": "12.0.0",
    "jose": "^6.2.10",
    "jsonapi-serializer": "3.6.9",
    "jsonwebtoken": "9.0.3",
    "linkedin-api-client": "0.3.0",
    "marked": "18.0.11",
    "multer": "2.3.0",
    "openai": "7.9.0",
    "rss": "1.2.2",
    "rxjs": "7.8.2",
    "tsconfig-paths": "4.2.0",
    "twitter-api-v2": "1.29.1",
    "twitter-text": "3.1.0",
    "@genfeedai/contracts": "workspace:*"
  },
  "description": "Genfeed API Service",
  "devDependencies": {
    "@nestjs/testing": "12.0.1",
    "@types/archiver": "8.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/jsonapi-serializer": "3.6.8",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/pg": "8.23.1",
    "@types/rss": "0.0.32",
    "@types/supertest": "^7.2.1",
    "@types/twitter-text": "3.1.10",
    "pg": "8.23.0",
    "supertest": "^7.2.2",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11"
  },
  "main": "../dist/apps/api/main.js",
  "name": "@genfeedai/api",
  "private": true,
  "scripts": {
    "build": "cd .. && nest build api && nest build api-credential-backfill && nest build api-articles-seed",
    "build:prod": "cd .. && nest build api && nest build api-credential-backfill && nest build api-articles-seed && cd api && (bun run sentry:sourcemaps || true)",
    "backfill:post-status:dry": "bun run scripts/backfill-post-status.ts",
    "backfill:post-status:live": "bun run scripts/backfill-post-status.ts --live",
    "cleanup:orphan-social-oauth:dry": "bun run scripts/cleanup-orphan-social-oauth.ts",
    "cleanup:orphan-social-oauth:live": "bun run scripts/cleanup-orphan-social-oauth.ts --live",
    "deps:update": "bunx npm-check-updates -u --reject typescript,better-auth && bun install",
    "dev": "bun run ../../../scripts/dev/run-portless.ts api -- bun run dev:process",
    "dev:webpack": "cd .. && NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" nest start api --watch",
    "encrypt:credentials": "bun run scripts/backfill-credential-encryption.ts --live",
    "encrypt:credentials:dry": "bun run scripts/backfill-credential-encryption.ts",
    "lint": "bun run scripts/check-request-context-usage.ts && biome lint --write src --no-errors-on-unmatched",
    "migrate:credentials": "node --max-old-space-size=8192 --expose-gc -r tsconfig-paths/register ../dist/apps/api-credential-backfill/main --live",
    "migrate:credentials:dry": "node --max-old-space-size=8192 --expose-gc -r tsconfig-paths/register ../dist/apps/api-credential-backfill/main",
    "migrate:post-visibility": "bun run scripts/backfill-post-visibility.ts --live",
    "migrate:post-visibility:dry": "bun run scripts/backfill-post-visibility.ts",
    "migrate:review-decisions": "bun run scripts/normalize-review-decisions.ts --live",
    "migrate:review-decisions:dry": "bun run scripts/normalize-review-decisions.ts",
    "migrate:retired-content": "bun run scripts/retire-content-drafts.ts --live",
    "migrate:retired-content:dry": "bun run scripts/retire-content-drafts.ts",
    "openapi:emit": "bun run scripts/emit-openapi.ts",
    "openapi:emit:prebuilt": "bun run scripts/emit-openapi.ts --skip-build",
    "openapi:validate": "bun run scripts/validate-openapi-spec.ts",
    "seed:articles": "bun run scripts/seeds/articles.seed.ts --live",
    "seed:articles:compiled": "node --max-old-space-size=8192 --expose-gc -r tsconfig-paths/register ../dist/apps/api-articles-seed/main",
    "seed:articles:dry": "bun run scripts/seeds/articles.seed.ts",
    "seed:local-debug": "bun run scripts/seeds/local-debug-data.seed.ts",
    "seed:local-debug:live": "bun run scripts/seeds/local-debug-data.seed.ts --live",
    "seed:workflows": "bun run scripts/seeds/workflows.seed.ts",
    "seed:workflows:dry": "bun run scripts/seeds/workflows.seed.ts --dry-run",
    "purge:prelaunch-corpus": "bun run scripts/seeds/purge-prelaunch-reference-corpus.ts --live",
    "purge:prelaunch-corpus:dry": "bun run scripts/seeds/purge-prelaunch-reference-corpus.ts",
    "sentry:inject": "sentry-cli sourcemaps inject --org genfeedai --project api-genfeed-ai ../dist/apps/api",
    "sentry:sourcemaps": "[ -z \"$SENTRY_AUTH_TOKEN\" ] && echo 'Sentry upload skipped (no token)' || (bun run sentry:inject && bun run sentry:upload)",
    "sentry:upload": "sentry-cli sourcemaps upload --org genfeedai --project api-genfeed-ai ../dist/apps/api",
    "start": "cd .. && nest start api",
    "start:debug": "cd .. && nest start api --debug --watch",
    "start:dev": "cd .. && NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" nest start api --watch",
    "start:prod": "node --max-old-space-size=8192 --expose-gc -r tsconfig-paths/register ../dist/apps/api/main",
    "test": "vitest run --config vitest.config.ts",
    "type-check": "bun run ../../../scripts/architecture/check-typecheck-prerequisites.ts --require-turbo && tsc --noEmit -p tsconfig.typecheck.json",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:e2e": "bun run test:e2e:full",
    "test:e2e:core": "bun run scripts/api-e2e-tiers.ts core",
    "test:e2e:cov": "vitest run --coverage --config vitest.config.e2e.ts",
    "test:e2e:full": "bun run scripts/api-e2e-tiers.ts full",
    "test:e2e:isolated-publish": "bun run scripts/api-e2e-tiers.ts isolated-publish",
    "test:file": "vitest run --config vitest.config.ts",
    "test:file:cov": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest watch --config vitest.config.ts",
    "dev:process": "NODE_OPTIONS=\"--max-old-space-size=4096 --expose-gc\" bun run ../../../scripts/dev/run-service.ts api -- bun run ../../../scripts/dev/nest-fast-dev.ts api",
    "dev:debug": "bun run dev:process"
  },
  "version": "1.0.0",
  "type": "module"
}
