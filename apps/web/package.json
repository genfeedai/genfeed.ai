    "@genfeedai/harness": "*",
    "@genfeedai/helpers": "*",
    "@genfeedai/integrations": "workspace:*",
    "@genfeedai/next-config": "*",
    "@genfeedai/pricing": "*",
    "@genfeedai/styles": "*",
    "@genfeedai/ui": "*",
    "@genfeedai/workflows": "*",
    "@remotion/player": "4.0.538",
    "@serwist/turbopack": "9.5.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-blockquote": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-mention": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-strike": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "@xyflow/react": "12.12.0",
    "fullcalendar": "7.1.3",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "posthog-js": "1.438.21",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.538",
    "serwist": "9.5.13",
    "zustand": "5.0.16"
  },
  "description": "Genfeed Content Hub - Unified content management, publishing, and analytics",
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@genfeedai/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "26.x"
  },
  "name": "@genfeedai/web",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "next build --turbopack --experimental-analyze",
    "analyze:serve": "next experimental-analyze",
    "build": "NODE_OPTIONS=--max-old-space-size=6144 next build --turbopack",
    "deps:update": "bunx npm-check-updates -u --reject typescript,@types/node && bun install",
    "predev": "bunx turbo run build --filter=@genfeedai/integrations",
    "dev": "bun run ../../scripts/dev/run-portless.ts app -- bun run dev:process",
    "lint": "biome check app i18n messages src packages tests instrumentation.ts jsx-compat.d.ts next.config.ts next.config.test.ts package.json postcss.config.mjs proxy.ts proxy.test.ts remotion.d.ts sentry.edge.config.ts sentry.server.config.ts tailwind.config.ts tsconfig.json tsconfig.test.json vercel.json",
    "start": "next start",
    "test": "vitest run --config ./vitest.config.mts --maxWorkers=2",
    "test:cov": "vitest run --coverage --config ./vitest.config.mts --maxWorkers=2",
    "test:cov:shard": "vitest run --coverage --config ./vitest.config.mts --maxWorkers=2",
    "test:watch": "vitest --config ./vitest.config.mts",
    "type-check": "bun run ../../scripts/architecture/check-typecheck-prerequisites.ts && rm -rf .next && next typegen && tsc --noEmit",
    "dev:process": "bun run ../../scripts/dev/prune-next-cache.ts && NODE_OPTIONS='--max-old-space-size=4096 --disable-warning=DEP0169' bun run ../../scripts/dev/run-service.ts app -- next dev --turbopack",
    "dev:debug": "bun run dev:process",
    "dev:clean": "bun run ../../scripts/dev/prune-next-cache.ts"
  },
  "sideEffects": [
    "**/*.css",
    "./*.ts",
    "./app/**",
    "./i18n/**",
    "./packages/**",
    "./src/features/**",
    "./src/lib/**",
    "./src/providers/**",
    "./src/store/**",
    "./src/types/**"
  ],
  "version": "1.0.0"
}
