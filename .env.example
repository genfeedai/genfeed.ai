AWS_SECRET_ACCESS_KEY=
# OPTIONAL: S3 bucket for media storage; unset uses cdn.genfeed.ai.
# OPTIONAL: S3 bucket for media storage; unset uses cdn.genfeed.ai.
AWS_S3_BUCKET=
# Workers queue-health thresholds (global, per queue)
# OPTIONAL: Waiting jobs per queue before the health check alerts; defaults to 100.
# OPTIONAL: Waiting jobs per queue before the health check alerts; defaults to 100.
QUEUE_HEALTH_MAX_WAITING=100
# OPTIONAL: Age in minutes of the oldest waiting job before alerting; defaults to 15.
