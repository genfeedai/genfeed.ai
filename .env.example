NEXT_PUBLIC_APPS_APP_ENDPOINT=https://app.genfeed.localhost
# OPTIONAL: Marketplace URL used in links; defaults to the hosted https://marketplace.genfeed.ai.
# OPTIONAL: Marketplace URL used in links; defaults to the hosted https://marketplace.genfeed.ai.
NEXT_PUBLIC_APPS_MARKETPLACE_ENDPOINT=https://marketplace.genfeed.localhost
# OPTIONAL: Marketing website URL used in links; defaults to the hosted https://genfeed.ai.
# OPTIONAL: Marketing website URL used in links; defaults to the hosted https://genfeed.ai.
NEXT_PUBLIC_APPS_WEBSITE_ENDPOINT=https://website.genfeed.localhost
# OPTIONAL: Booking link for "talk to sales" buttons; defaults to the Genfeed Calendly page.
