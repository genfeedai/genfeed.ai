# ============================================
# GENFEED.AI CANONICAL ENV TEMPLATE
# ============================================
# Copy this file to one of:
# - .env.local        for local development
# - .env.staging      for staging deployments
# - .env.production   for production deployments
#
# Then generate app/service env files with:
#   bun run env:sync local --prune-legacy
#   bun run env:sync staging
#   bun run env:sync production
#
# Root env files are the only source of truth.
# App and service .env files are generated outputs.
#
# Every variable is tagged on the line above it:
#   REQUIRED  the stack fails config validation, or a core flow (sign-in, API
#             calls, first generation) breaks, if it is unset or empty.
#   OPTIONAL  safe to leave empty. It has a code default or an automatic
#             fallback, or it only unlocks an add-on integration.
#   "Cloud: required"  an OPTIONAL variable that becomes mandatory only for
#             hosted Genfeed Cloud (GENFEED_CLOUD=true or a *.genfeed.ai URL).
#             Self-hosted and local installs can leave it empty.
#
# Required values are listed first. Everything after them is OPTIONAL.
#
# Every variable is tagged on the line above it:
#   REQUIRED  the stack fails config validation, or a core flow (sign-in, API
#             calls, first generation) breaks, if it is unset or empty.
#   OPTIONAL  safe to leave empty. It has a code default or an automatic
#             fallback, or it only unlocks an add-on integration.
#   "Cloud: required"  an OPTIONAL variable that becomes mandatory only for
#             hosted Genfeed Cloud (GENFEED_CLOUD=true or a *.genfeed.ai URL).
#             Self-hosted and local installs can leave it empty.
#
# Required values are listed first. Everything after them is OPTIONAL.
# ============================================

# --------------------------------------------
# REQUIRED - set these in every deployment
# --------------------------------------------
# REQUIRED: PostgreSQL connection string; the API and workers fail config validation without it. The value below matches docker/local.
# REQUIRED: PostgreSQL connection string; the API and workers fail config validation without it. The value below matches docker/local.
DATABASE_URL=postgresql://genfeed:genfeed_local@localhost:5432/genfeed
# REQUIRED: Session signing secret while BETTER_AUTH_ENABLED=true (the default); the API refuses to boot with it empty. The placeholder lets a fresh checkout start in development only. Replace it with your own (openssl rand -base64 48), and always for staging, production or any shared host.
# REQUIRED: Session signing secret while BETTER_AUTH_ENABLED=true (the default); the API refuses to boot with it empty. The placeholder lets a fresh checkout start in development only. Replace it with your own (openssl rand -base64 48), and always for staging, production or any shared host.
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
# REQUIRED: 32+ character key that encrypts stored provider credentials; saving a key in Settings -> API Keys fails without it. Generate one with openssl rand -base64 32 and keep it stable. The Docker self-host bundle generates it for you.
# REQUIRED: 32+ character key that encrypts stored provider credentials; saving a key in Settings -> API Keys fails without it. Generate one with openssl rand -base64 32 and keep it stable. The Docker self-host bundle generates it for you.
TOKEN_ENCRYPTION_KEY=
# REQUIRED: OpenRouter key that serves the default text and agent models; without a valid key text generation and the agent do not work. Create one at https://openrouter.ai/keys.
# REQUIRED: OpenRouter key that serves the default text and agent models; without a valid key text generation and the agent do not work. Create one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# REQUIRED: Base URL where uploaded and generated media is served; the files service fails config validation without it.
# REQUIRED: Base URL where uploaded and generated media is served; the files service fails config validation without it.
GENFEEDAI_CDN_URL=https://staging-cdn.genfeed.ai
# REQUIRED: API base URL the browser calls. Unset, the app falls back to the hosted https://api.genfeed.ai/v1, so a self-hosted app would talk to the wrong API.
# REQUIRED: API base URL the browser calls. Unset, the app falls back to the hosted https://api.genfeed.ai/v1, so a self-hosted app would talk to the wrong API.
NEXT_PUBLIC_API_ENDPOINT=https://app.genfeed.localhost/v1
# REQUIRED: Notifications WebSocket origin the browser connects to for live generation updates. Unset, it falls back to the hosted https://notifications.genfeed.ai.
# REQUIRED: Notifications WebSocket origin the browser connects to for live generation updates. Unset, it falls back to the hosted https://notifications.genfeed.ai.
NEXT_PUBLIC_WS_ENDPOINT=https://notifications.genfeed.localhost
# REQUIRED: Listen port for the workers service (mapped to PORT, which the workers config requires). Compose uses 3013 by default.
# REQUIRED: Listen port for the workers service (mapped to PORT, which the workers config requires). Compose uses 3013 by default.
WORKERS_PORT=3013

# --------------------------------------------
# REQUIRED - set these in every deployment
# --------------------------------------------

# --------------------------------------------
# Shared Runtime
# --------------------------------------------
# OPTIONAL: development, staging, production or test; defaults to development. Staging and production stop auto-trusting loopback origins for sign-in.
# OPTIONAL: development, staging, production or test; defaults to development. Staging and production stop auto-trusting loopback origins for sign-in.
NODE_ENV=development
# OPTIONAL: Redis URL for queues, pub/sub, cache and rate limits; defaults to redis://localhost:6379. A reachable Redis is still mandatory.
# OPTIONAL: Redis URL for queues, pub/sub, cache and rate limits; defaults to redis://localhost:6379. A reachable Redis is still mandatory.
REDIS_URL=redis://localhost:6379
# Which Redis implementation the backends use. Defaults to `redis` when unset,
# which is what cloud and community must run: multiple processes share cache,
# pub/sub, and queue state through a real broker. `in-process` serves pub/sub
# from memory and is only valid for single-process deployments (desktop, #2382).
# Left commented deliberately — it is not in scripts/env-spec.ts, so it never
# lands in a generated backend env file by accident.
# REDIS_DRIVER=redis

# --------------------------------------------
# Shared URLs
# --------------------------------------------
# Normal `bun run dev*` commands use clean Portless HTTPS routes and derive
# worktree-aware service URLs from PORTLESS_URL at runtime. Explicit
# `dev:direct:*`, E2E, and Docker commands own their bind ports.
# OPTIONAL: Server-side API URL the Next.js app proxies requests to; defaults to http://localhost:3010.
# OPTIONAL: Server-side API URL the Next.js app proxies requests to; defaults to http://localhost:3010.
API_URL=https://api.genfeed.localhost
# OPTIONAL: Public API URL given to browsers and providers (OAuth callbacks, links). Cloud: required.
# OPTIONAL: Public API URL given to browsers and providers (OAuth callbacks, links). Cloud: required.
GENFEEDAI_API_PUBLIC_URL=https://api.genfeed.localhost
# OPTIONAL: API base URL the other services use to call the API. Cloud: required.
# OPTIONAL: API base URL the other services use to call the API. Cloud: required.
GENFEEDAI_API_URL=https://api.genfeed.localhost
# OPTIONAL: Public app URL used for auth error redirects (to /login) and links. Cloud: required.
# OPTIONAL: Public app URL used for auth error redirects (to /login) and links. Cloud: required.
GENFEEDAI_APP_URL=https://app.genfeed.localhost
# OPTIONAL: Public website origin used in OAuth metadata and checkout return links.
# OPTIONAL: Public website origin used in OAuth metadata and checkout return links.
GENFEEDAI_PUBLIC_URL=https://website.genfeed.localhost
# OPTIONAL: Files service URL used by the API and workers; defaults to http://localhost:3012 when self-hosted.
# OPTIONAL: Files service URL used by the API and workers; defaults to http://localhost:3012 when self-hosted.
GENFEEDAI_MICROSERVICES_FILES_URL=https://files.genfeed.localhost
# OPTIONAL: MCP service URL used by the API; defaults to http://localhost:3014 when self-hosted.
# OPTIONAL: MCP service URL used by the API; defaults to http://localhost:3014 when self-hosted.
GENFEEDAI_MICROSERVICES_MCP_URL=https://mcp.genfeed.localhost
# OPTIONAL: Public MCP URL advertised in OAuth protected-resource metadata. Cloud: required.
# OPTIONAL: Public MCP URL advertised in OAuth protected-resource metadata. Cloud: required.
GENFEEDAI_MCP_PUBLIC_URL=https://mcp.genfeed.localhost/mcp
# OPTIONAL: Notifications service URL used by the API; defaults to http://localhost:3011 when self-hosted.
# OPTIONAL: Notifications service URL used by the API; defaults to http://localhost:3011 when self-hosted.
GENFEEDAI_MICROSERVICES_NOTIFICATIONS_URL=https://notifications.genfeed.localhost
# OPTIONAL: Public HTTPS base URL that providers call back with webhooks (for local development use a tunnel such as https://<your-id>.ngrok-free.app). Empty or a localhost/private URL turns provider webhooks off. Cloud: required.
# OPTIONAL: Public HTTPS base URL that providers call back with webhooks (for local development use a tunnel such as https://<your-id>.ngrok-free.app). Empty or a localhost/private URL turns provider webhooks off. Cloud: required.
GENFEEDAI_WEBHOOKS_URL=
# OPTIONAL: API key the notifications and MCP services use to call the Genfeed API; they run without it.
# OPTIONAL: API key the notifications and MCP services use to call the Genfeed API; they run without it.
GENFEEDAI_API_KEY=

# --------------------------------------------
# Shared Auth / Edition
# --------------------------------------------
# OPTIONAL: true (the default) turns login and sign-up on; false runs without a login wall.
# OPTIONAL: true (the default) turns login and sign-up on; false runs without a login wall.
BETTER_AUTH_ENABLED=true
# OPTIONAL: Better Auth dashboard/infra API key; leave empty unless you use that service.
# OPTIONAL: Better Auth dashboard/infra API key; leave empty unless you use that service.
BETTER_AUTH_API_KEY=
# OPTIONAL: Public base URL of the API's auth endpoints; defaults to http://localhost:<port>. Set it for any non-local host.
# OPTIONAL: Public base URL of the API's auth endpoints; defaults to http://localhost:<port>. Set it for any non-local host.
BETTER_AUTH_URL=https://api.genfeed.localhost
# OPTIONAL: Comma-separated browser origins allowed to call auth. Optional in development, where loopback origins are trusted; in staging and production list your app origin or sign-in is rejected.
# OPTIONAL: Comma-separated browser origins allowed to call auth. Optional in development, where loopback origins are trusted; in staging and production list your app origin or sign-in is rejected.
BETTER_AUTH_TRUSTED_ORIGINS=https://app.genfeed.localhost,https://website.genfeed.localhost
# OPTIONAL: Google OAuth client ID; enables Google sign-in (the YouTube, Google Ads and Search Console connectors share this client). Cloud: required.
# OPTIONAL: Google OAuth client ID; enables Google sign-in (the YouTube, Google Ads and Search Console connectors share this client). Cloud: required.
GOOGLE_OAUTH_CLIENT_ID=
# OPTIONAL: Google OAuth client secret; pairs with the client ID above. Cloud: required.
# OPTIONAL: Google OAuth client secret; pairs with the client ID above. Cloud: required.
GOOGLE_OAUTH_CLIENT_SECRET=
# OPTIONAL: Browser-side mirror of BETTER_AUTH_ENABLED; keep the two equal.
# OPTIONAL: Browser-side mirror of BETTER_AUTH_ENABLED; keep the two equal.
NEXT_PUBLIC_BETTER_AUTH_ENABLED=true
# OPTIONAL: Browser-side switch for hosted Genfeed Cloud mode; leave empty when self-hosting.
# OPTIONAL: Browser-side switch for hosted Genfeed Cloud mode; leave empty when self-hosting.
NEXT_PUBLIC_GENFEED_CLOUD=
# OPTIONAL: Set to true only for hosted Genfeed Cloud mode, which makes the variables tagged "Cloud: required" mandatory; leave empty when self-hosting.
# OPTIONAL: Set to true only for hosted Genfeed Cloud mode, which makes the variables tagged "Cloud: required" mandatory; leave empty when self-hosting.
GENFEED_CLOUD=
# OPTIONAL: License key that unlocks licensed editions; empty runs the Core edition.
# OPTIONAL: License key that unlocks licensed editions; empty runs the Core edition.
GENFEED_LICENSE_KEY=
# OPTIONAL: Edition label forwarded to the app and website; no code in this repo reads it today.
# OPTIONAL: Edition label forwarded to the app and website; no code in this repo reads it today.
NEXT_PUBLIC_GENFEED_EDITION=Core
# OPTIONAL: Browser-side license flag; any non-empty value marks the app as licensed. Leave empty for Core.
# OPTIONAL: Browser-side license flag; any non-empty value marks the app as licensed. Leave empty for Core.
NEXT_PUBLIC_GENFEED_LICENSE_KEY=
# OPTIONAL: E2E-only switch that bypasses some auth and admin gates; keep false.
# OPTIONAL: E2E-only switch that bypasses some auth and admin gates; keep false.
NEXT_PUBLIC_PLAYWRIGHT_TEST=false

# --------------------------------------------
# Shared Frontend
# --------------------------------------------
# OPTIONAL: MCP URL shown in the app; defaults to http://localhost:3014/mcp when self-hosted.
# OPTIONAL: MCP URL shown in the app; defaults to http://localhost:3014/mcp when self-hosted.
NEXT_PUBLIC_MCP_ENDPOINT=https://mcp.genfeed.localhost/mcp
# OPTIONAL: API base the shared workflows UI falls back to for plain fetches; the self-hosted image builds with /v1.
# OPTIONAL: API base the shared workflows UI falls back to for plain fetches; the self-hosted image builds with /v1.
NEXT_PUBLIC_API_URL=https://app.genfeed.localhost/v1
# OPTIONAL: CDN base the browser loads media and logos from; defaults to the hosted https://cdn.genfeed.ai.
# OPTIONAL: CDN base the browser loads media and logos from; defaults to the hosted https://cdn.genfeed.ai.
NEXT_PUBLIC_CDN_URL=https://staging-cdn.genfeed.ai
# OPTIONAL: Environment label on browser Sentry events; Sentry still works without it.
# OPTIONAL: Environment label on browser Sentry events; Sentry still works without it.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# OPTIONAL: Environment label on server Sentry events. Cloud: required.
# OPTIONAL: Environment label on server Sentry events. Cloud: required.
SENTRY_ENVIRONMENT=development
# OPTIONAL: Sentry token used only to upload source maps during production builds; leave empty unless you publish source maps.
# OPTIONAL: Sentry token used only to upload source maps during production builds; leave empty unless you publish source maps.
SENTRY_AUTH_TOKEN=
# OPTIONAL: Sentry organization slug for source-map upload; defaults to genfeedai.
# OPTIONAL: Sentry organization slug for source-map upload; defaults to genfeedai.
SENTRY_ORG=genfeedai

