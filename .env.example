QUEUE_HEALTH_MAX_OLDEST_WAITING_MINUTES=15
# OPTIONAL: Failed jobs per queue before alerting; defaults to 25.
# OPTIONAL: Failed jobs per queue before alerting; defaults to 25.
QUEUE_HEALTH_MAX_FAILED=25
# OPTIONAL: Minimum minutes between repeat queue alerts; defaults to 60.
# OPTIONAL: Minimum minutes between repeat queue alerts; defaults to 60.
QUEUE_HEALTH_ALERT_THROTTLE_MINUTES=60
