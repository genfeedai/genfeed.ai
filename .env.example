APP_NEXT_PUBLIC_BETTER_AUTH_SIGN_UP_FORCE_REDIRECT_URL=/onboarding/post-signup
# OPTIONAL: Fallback post-sign-in redirect forwarded to the app; no code in this repo reads it today.
# OPTIONAL: Fallback post-sign-in redirect forwarded to the app; no code in this repo reads it today.
APP_NEXT_PUBLIC_BETTER_AUTH_SIGN_IN_FALLBACK_REDIRECT_URL=/
# OPTIONAL: Fallback post-sign-up redirect forwarded to the app; no code in this repo reads it today.
# OPTIONAL: Fallback post-sign-up redirect forwarded to the app; no code in this repo reads it today.
APP_NEXT_PUBLIC_BETTER_AUTH_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding/post-signup
# OPTIONAL: Server-side post-sign-up redirect forwarded to the app; no code in this repo reads it today.
# OPTIONAL: Server-side post-sign-up redirect forwarded to the app; no code in this repo reads it today.
APP_BETTER_AUTH_SIGN_UP_FORCE_REDIRECT_URL=/onboarding/post-signup
# OPTIONAL: OAuth callback for connecting Medium (becomes MEDIUM_REDIRECT_URI); Medium connect is off without Medium credentials.
# OPTIONAL: OAuth callback for connecting Medium (becomes MEDIUM_REDIRECT_URI); Medium connect is off without Medium credentials.
APP_MEDIUM_REDIRECT_URI=https://app.genfeed.localhost/auth/medium/callback
# OPTIONAL: Google Analytics ID; no code in this repo reads it today.
# OPTIONAL: Google Analytics ID; no code in this repo reads it today.
NEXT_PUBLIC_GA_ID=
# OPTIONAL: Shows the text-to-speech workflow node as enabled when true; defaults to off.
# OPTIONAL: Shows the text-to-speech workflow node as enabled when true; defaults to off.
NEXT_PUBLIC_TTS_ENABLED=false
# Checkout price IDs, read in the browser. These are what the customer is
# charged; the server-side STRIPE_PRICE_SUBSCRIPTION_* values below only
# classify an incoming price, so the two sets must always point at the same
# Stripe prices. Leave a tier blank and its plan renders as unavailable.
# OPTIONAL: Stripe price ID for pay-as-you-go checkout (hosted billing); the plan shows as unavailable when empty.
# OPTIONAL: Stripe price ID for pay-as-you-go checkout (hosted billing); the plan shows as unavailable when empty.
NEXT_PUBLIC_STRIPE_PRICE_PAYG=
# OPTIONAL: Stripe price ID for Scale monthly checkout; the plan shows as unavailable when empty.
NEXT_PUBLIC_STRIPE_PRICE_SUBSCRIPTION_SCALE_MONTHLY=
# OPTIONAL: Stripe price ID for Enterprise monthly checkout; the plan shows as unavailable when empty.
# OPTIONAL: Stripe price ID for Enterprise monthly checkout; the plan shows as unavailable when empty.
NEXT_PUBLIC_STRIPE_PRICE_SUBSCRIPTION_ENTERPRISE_MONTHLY=

# OPTIONAL: Sentry DSN for the marketing website's browser errors; empty disables reporting.
# OPTIONAL: Sentry DSN for the marketing website's browser errors; empty disables reporting.
WEBSITE_NEXT_PUBLIC_SENTRY_DSN=
# OPTIONAL: Sentry project slug for the website's source-map upload; used only with SENTRY_AUTH_TOKEN.
# OPTIONAL: Sentry project slug for the website's source-map upload; used only with SENTRY_AUTH_TOKEN.
WEBSITE_SENTRY_PROJECT=website-genfeed-ai
# OPTIONAL: Assets base URL forwarded to the app and website; no code in this repo reads it today.
