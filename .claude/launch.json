{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website (direct)",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "bun run dev:direct:website"],
      "port": 3002
    },
    {
      "name": "app (direct)",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "bun run dev:direct:app"],
      "port": 3000
    },
    {
      "name": "api (direct)",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "bun run --cwd apps/server/api dev:direct"],
      "port": 3010
    },
    {
      "name": "notifications (direct)",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "bun run --cwd apps/server/notifications dev:direct"
      ],
      "port": 3111
    }
  ]
}
